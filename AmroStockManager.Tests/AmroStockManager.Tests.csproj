<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Link source files from the main project without creating a MAUI project dependency -->
  <ItemGroup>
    <Compile Include="..\AmroStockManager\Data\AppDbContext.cs"       Link="Data\AppDbContext.cs" />
    <Compile Include="..\AmroStockManager\Data\Models\*.cs"           Link="Data\Models\%(Filename)%(Extension)" />
    <Compile Include="..\AmroStockManager\Services\ReservationService.cs"  Link="Services\ReservationService.cs" />
    <Compile Include="..\AmroStockManager\Services\ResidentService.cs"     Link="Services\ResidentService.cs" />
    <Compile Include="..\AmroStockManager\Services\GeneralItemService.cs"  Link="Services\GeneralItemService.cs" />
    <Compile Include="..\AmroStockManager\Services\DeliveryService.cs"     Link="Services\DeliveryService.cs" />
    <Compile Include="..\AmroStockManager\Services\SyncMerge.cs"           Link="Services\SyncMerge.cs" />
  </ItemGroup>

</Project>
