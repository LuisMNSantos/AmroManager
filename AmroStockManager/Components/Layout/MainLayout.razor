@inherits LayoutComponentBase
@using Microsoft.Maui
@using Microsoft.Maui.Storage
@using AmroStockManager.Components.Pages
@inject ConnectivityService Connectivity
@inject IDialogService DialogService
@inject WhatsAppService WhatsAppSvc
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">AMRO Porto Manager</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Search"
                       Color="Color.Inherit"
                       Title="Pesquisa global (Ctrl+K)"
                       OnClick="OpenSearch" />
        <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleDarkMode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always"
               Style="display:flex; flex-direction:column;">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="mt-1"><b>Navegação</b></MudText>
        </MudDrawerHeader>

        <div style="flex:1; overflow-y:auto;">
            <MudNavMenu>
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
                    Painel
                </MudNavLink>
                <MudNavLink Href="/products" Icon="@Icons.Material.Filled.Inventory2">
                    Produtos
                </MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Href="/general-items" Icon="@Icons.Material.Filled.Category">
                    Artigos Gerais
                </MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Href="/calendario" Icon="@Icons.Material.Filled.CalendarMonth">
                    Reservas
                </MudNavLink>
                <MudNavLink Href="/encomendas" Icon="@Icons.Material.Filled.LocalShipping">
                    Encomendas & Cartas
                </MudNavLink>
                <MudNavLink Href="/visitas" Icon="@Icons.Material.Filled.PersonPin">
                    Visitas
                </MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Href="/whatsapp" Icon="@Icons.Custom.Brands.WhatsApp">
                    WhatsApp
                </MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Href="/administracao" Icon="@Icons.Material.Filled.AdminPanelSettings">
                    Administração
                </MudNavLink>
            </MudNavMenu>
        </div>

        <div style="padding: 14px 16px 18px; border-top: 1px solid rgba(0,0,0,0.10);">
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="font-weight:700; letter-spacing:0.04em;">
                    AMRO Porto Manager
                </MudText>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block" Style="padding-left:2px;">
                Versão 3.6 &nbsp;·&nbsp; 2026
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1" Style="padding-left:2px;">
                Desenvolvido por <span style="font-weight:600; color:var(--mud-palette-primary);">Luis Santos</span>
            </MudText>
        </div>
    </MudDrawer>

    <MudMainContent>
        @if (!Connectivity.IsOnline)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Square="true"
                      Style="border-radius:0; position:sticky; top:0; z-index:1000;">
                <MudIcon Icon="@Icons.Material.Filled.WifiOff" Size="Size.Small" Class="mr-1" Style="vertical-align:middle;" />
                Sem ligação à internet. Algumas funcionalidades podem não estar disponíveis.
            </MudAlert>
        }
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="@(_isWhatsAppPage ? "pa-0" : "pt-6 pb-6")">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen     = true;
    private bool _drawerOpenLast = true;
    private bool _isDark;
    private bool _isWhatsAppPage;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#1565C0",
            PrimaryDarken    = "#003c8f",
            PrimaryLighten   = "#5e92f3",
            Secondary        = "#388E3C",
            AppbarBackground = "#1565C0",
        },
        PaletteDark = new PaletteDark
        {
            Primary          = "#5e92f3",
            PrimaryDarken    = "#1565C0",
            PrimaryLighten   = "#90caf9",
            Secondary        = "#66BB6A",
            AppbarBackground = "#1a237e",
        }
    };

    protected override void OnInitialized()
    {
        _isDark = Preferences.Default.ContainsKey("darkMode")
            ? Preferences.Default.Get("darkMode", false)
            : Application.Current?.RequestedTheme == AppTheme.Dark;

        _isWhatsAppPage = new Uri(NavManager.Uri).AbsolutePath == "/whatsapp";

        Connectivity.Changed                      += OnConnectivityChanged;
        NavManager.LocationChanged                += OnLocationChanged;
        WhatsAppSvc.NavigateToWhatsAppRequested   += OnNavigateToWhatsApp;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = new Uri(e.Location).AbsolutePath;
        _isWhatsAppPage = path == "/whatsapp";
        if (!_isWhatsAppPage)
            WhatsAppSvc.Close();
        InvokeAsync(StateHasChanged);
    }

    private void OnNavigateToWhatsApp()
        => InvokeAsync(() => NavManager.NavigateTo("/whatsapp"));

    private void OnConnectivityChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _drawerOpen != _drawerOpenLast)
        {
            _drawerOpenLast = _drawerOpen;
            await MeasureContentAreaAsync();
        }
    }

    private async Task MeasureContentAreaAsync()
    {
        try
        {
            var r = await JS.InvokeAsync<ContentRect>("amro.getMainContentRect");
            WhatsAppSvc.SetContentArea(r.Left, r.Top, r.Width, r.Height);
        }
        catch { }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OpenSearch() =>
        DialogService.ShowAsync<GlobalSearchDialog>(string.Empty,
            new DialogOptions { CloseOnEscapeKey = true, BackdropClick = true, NoHeader = true });

    private void ToggleDarkMode()
    {
        _isDark = !_isDark;
        Preferences.Default.Set("darkMode", _isDark);
    }

    public void Dispose()
    {
        Connectivity.Changed                    -= OnConnectivityChanged;
        NavManager.LocationChanged              -= OnLocationChanged;
        WhatsAppSvc.NavigateToWhatsAppRequested -= OnNavigateToWhatsApp;
    }

    private record ContentRect(double Left, double Top, double Width, double Height);

}
