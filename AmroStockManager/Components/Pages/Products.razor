@page "/products"
@using ClosedXML.Excel
@inject ProductService ProductSvc
@inject StockService StockSvc
@inject RenewerKitService KitSvc
@inject SupabaseRealtimeService Realtime
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable
<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Produtos</MudText>
    <div class="d-flex gap-2">
        <MudButton StartIcon="@Icons.Material.Filled.SwapHoriz"
                   Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="OpenTradeDialog">
            Troca
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@(() => Nav.NavigateTo("/products/new"))">
            Adicionar Produto
        </MudButton>
    </div>
</div>

<!-- Kit de Renovador -->
<MudExpansionPanels Elevation="2" Class="mb-4">
    <MudExpansionPanel>
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Backpack" Color="Color.Success" />
                <MudText Typo="Typo.h6">Kit de Renovador</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                    @_kitDeliveryCount @(_kitDeliveryCount == 1 ? "kit entregue" : "kits entregues")
                </MudChip>
            </div>
        </TitleContent>
        <ChildContent>
            @if (_kitLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            }
            else
            {
                <!-- Configured kit items -->
                <MudText Typo="Typo.subtitle2" Class="mb-2">Produtos no kit</MudText>
                @if (_kitItems.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Nenhum produto configurado. Adiciona abaixo os produtos que compõem o kit.
                    </MudAlert>
                }
                else
                {
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        @foreach (var ki in _kitItems)
                        {
                            var kitItem = ki;
                            <MudChip T="string" Color="Color.Primary" OnClose="@(() => RemoveKitItem(kitItem))">
                                @ki.Product?.Name
                                <MudText Typo="Typo.caption" Color="Color.Surface" Class="ml-1">(@ki.Product?.Type)</MudText>
                            </MudChip>
                        }
                    </div>
                }

                <!-- Add product to kit -->
                <div class="d-flex gap-2 align-end flex-wrap mb-4">
                    <MudSelect T="string" @bind-Value="_kitAddProductId"
                               Label="Adicionar produto ao kit"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Style="min-width:220px;"
                               Disabled="@(_products.Count == 0)">
                        @foreach (var p in _products.Where(p => !_kitItems.Any(ki => ki.ProductId == p.Id)))
                        {
                            <MudSelectItem T="string" Value="@p.Id">@p.Name (@p.Type)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@string.IsNullOrEmpty(_kitAddProductId)"
                               OnClick="AddKitItem">
                        Adicionar
                    </MudButton>
                </div>

                <!-- Delivery history -->
                @if (_kitDeliveries.Count > 0)
                {
                    <MudDivider Class="mb-3" />
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                        <MudText Typo="Typo.subtitle2">Histórico de entregas</MudText>
                        <div class="d-flex align-center gap-2">
                            <MudSelect T="int" @bind-Value="_kitExportYear" Dense="true"
                                       Variant="Variant.Outlined" Style="min-width:90px;">
                                @foreach (var y in Enumerable.Range(2024, DateTime.Now.Year - 2024 + 1).Reverse())
                                {
                                    <MudSelectItem T="int" Value="@y">@y</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton StartIcon="@Icons.Material.Filled.FileDownload"
                                       Variant="Variant.Outlined" Color="Color.Success"
                                       Size="Size.Small" OnClick="ExportKitExcel">
                                Exportar Excel
                            </MudButton>
                        </div>
                    </div>
                    <MudTable Items="@KitDeliveriesPaged" Dense="true" Hover="true" Elevation="0"
                              Outlined="true" Class="rounded">
                        <HeaderContent>
                            <MudTh>Residente</MudTh>
                            <MudTh>Quarto</MudTh>
                            <MudTh>Items entregues</MudTh>
                            <MudTh>Entregue por</MudTh>
                            <MudTh>Data</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Residente">@context.ResidentName</MudTd>
                            <MudTd DataLabel="Quarto">@context.RoomNumber</MudTd>
                            <MudTd DataLabel="Items">
                                <div class="d-flex gap-1 flex-wrap">
                                    @foreach (var item in context.Items)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                            @item.ProductName — @item.Size
                                        </MudChip>
                                    }
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Entregue por">@context.DeliveredBy</MudTd>
                            <MudTd DataLabel="Data">@context.DeliveredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                        </RowTemplate>
                    </MudTable>
                    @if (KitPageCount > 1)
                    {
                        <div class="d-flex align-center justify-space-between mt-2 flex-wrap gap-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @((_kitPage - 1) * KitPageSize + 1)–@(Math.Min(_kitPage * KitPageSize, _kitDeliveries.Count)) de @_kitDeliveries.Count entregas
                            </MudText>
                            <MudPagination Count="KitPageCount" @bind-Selected="_kitPage"
                                           Color="Color.Primary" Size="Size.Small" />
                        </div>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ainda não foram entregues kits.</MudText>
                }
            }
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        <b>Erro ao carregar dados:</b> @_error
        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadProducts" Class="ml-2">Tentar novamente</MudButton>
    </MudAlert>
}

<MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_search"
                          Label="Pesquisar por nome, cor ou SKU"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="LoadProducts" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" @bind-Value="_typeFilter" Label="Tipo" SelectedValuesChanged="@((_) => LoadProducts())">
                <MudSelectItem T="string" Value="@("All")">Todos os Tipos</MudSelectItem>
                @foreach (var t in ProductService.ProductTypes)
                {
                    <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSwitch T="bool" Value="_lowStockOnly" Label="Apenas Stock Baixo" Color="Color.Warning"
                       ValueChanged="@((bool v) => { _lowStockOnly = v; _ = LoadProducts(); })" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_products.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Nenhum produto encontrado. <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/products/new"))">Adicione o seu primeiro produto.</MudButton>
    </MudAlert>
}
else
{
    @foreach (var product in _products)
    {
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.h6">@product.Name</MudText>
                        @if (product.HasLowStock)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                                Stock Baixo
                            </MudChip>
                        }
                    </div>
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(ProductService.IsBrinde(product.Type) ? Color.Info : Color.Primary)"
                                 Icon="@(ProductService.IsBrinde(product.Type) ? Icons.Material.Filled.CardGiftcard : Icons.Material.Filled.Checkroom)">
                            @product.Type
                        </MudChip>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @if (!string.IsNullOrEmpty(product.Color)) { <span>@product.Color · </span> }
                            @if (!string.IsNullOrEmpty(product.SKU)) { <span>SKU: @product.SKU · </span> }
                            <span>@product.TotalStock un.</span>
                        </MudText>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.LocalShipping"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenCampaignDialog(product))"
                                   Tooltip="Campanhas de distribuição" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => Nav.NavigateTo($"/products/{product.Id}/edit"))"
                                   Tooltip="Editar produto" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteProduct(product))"
                                   Tooltip="Eliminar produto" />
                </CardHeaderActions>
            </MudCardHeader>

            @if (product.SizeVariants.Count > 0)
            {
                <MudCardContent Class="pt-0">
                    <MudTable Items="@product.SizeVariants.OrderBy(sv => ProductService.SizeOrder(sv.Size))"
                              Dense="true" Hover="false" Elevation="0">
                        <HeaderContent>
                            <MudTh>Tamanho</MudTh>
                            <MudTh Style="text-align:center; width:80px;">Qtd.</MudTh>
                            <MudTh>Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @if (context.IsLowStock)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">@context.Size</MudChip>
                                }
                                else
                                {
                                    <MudText><b>@context.Size</b></MudText>
                                }
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudText Typo="Typo.h6"
                                         Color="@(context.IsLowStock ? Color.Error : Color.Default)">
                                    @context.Quantity
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <div class="d-flex gap-1 align-center">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenSaleDialog(context))"
                                               Disabled="@(context.Quantity == 0)">
                                        − Saída
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="@(() => QuickRestock(context))">
                                        + Entrada
                                    </MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                                   Size="Size.Small"
                                                   Tooltip="Ajuste personalizado"
                                                   OnClick="@(() => OpenAdjustDialog(context))" />
                                </div>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            }
            else
            {
                <MudCardContent Class="pt-0">
                    <MudText Color="Color.Secondary">Sem tamanhos definidos.
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   OnClick="@(() => Nav.NavigateTo($"/products/{product.Id}/edit"))">
                            Adicionar tamanhos
                        </MudButton>
                    </MudText>
                </MudCardContent>
            }
        </MudCard>
    }
}

@code {
    private string _search = string.Empty;
    private string _typeFilter = "All";
    private bool _lowStockOnly;
    private bool _loading = true;
    private string? _error;
    private List<Product> _products = [];

    // Kit de Renovador
    private bool _kitLoading = true;
    private List<RenewerKitItem> _kitItems = [];
    private List<RenewerKitDelivery> _kitDeliveries = [];
    private int _kitDeliveryCount;
    private string? _kitAddProductId;

    private int _kitExportYear = DateTime.Now.Year;

    private const int KitPageSize = 5;
    private int _kitPage = 1;
    private int KitPageCount => (int)Math.Ceiling((double)_kitDeliveries.Count / KitPageSize);
    private IEnumerable<RenewerKitDelivery> KitDeliveriesPaged =>
        _kitDeliveries.Skip((_kitPage - 1) * KitPageSize).Take(KitPageSize);

    protected override async Task OnInitializedAsync()
    {
        Realtime.TableChanged += OnTableChanged;
        await Task.WhenAll(LoadProducts(), LoadKitDataAsync());
    }

    private void OnTableChanged(string table)
    {
        if (table is "products" or "size_variants")
            InvokeAsync(LoadProducts);
    }

    public void Dispose() => Realtime.TableChanged -= OnTableChanged;

    private async Task LoadKitDataAsync()
    {
        _kitLoading = true;
        try
        {
            var kitTask       = KitSvc.GetKitItemsAsync();
            var deliveriesTask = KitSvc.GetAllDeliveriesAsync();
            var countTask      = KitSvc.GetDeliveryCountAsync();
            await Task.WhenAll(kitTask, deliveriesTask, countTask);
            _kitItems         = kitTask.Result;
            _kitDeliveries    = deliveriesTask.Result;
            _kitDeliveryCount = countTask.Result;
            _kitPage          = 1;
        }
        catch { /* non-critical, fail silently */ }
        finally { _kitLoading = false; }
    }

    private async Task AddKitItem()
    {
        if (string.IsNullOrEmpty(_kitAddProductId)) return;
        await KitSvc.AddKitItemAsync(_kitAddProductId);
        _kitAddProductId = null;
        await LoadKitDataAsync();
        StateHasChanged();
    }

    private async Task RemoveKitItem(RenewerKitItem item)
    {
        await KitSvc.RemoveKitItemAsync(item.Id);
        await LoadKitDataAsync();
        StateHasChanged();
    }

    private async Task ExportKitExcel()
    {
        try
        {
            var deliveries = await KitSvc.GetDeliveriesByYearAsync(_kitExportYear);

            if (deliveries.Count == 0)
            {
                Snackbar.Add($"Nenhuma entrega encontrada em {_kitExportYear}.", Severity.Warning);
                return;
            }

            using var wb = new XLWorkbook();

            // ── Sheet 1: Entregas ─────────────────────────────────────────────
            var ws1 = wb.Worksheets.Add("Entregas");
            string[] h1 = ["Residente", "Quarto", "Items entregues", "Entregue por", "Data", "Notas"];
            for (int i = 0; i < h1.Length; i++) ws1.Cell(1, i + 1).Value = h1[i];
            var hr1 = ws1.Range(1, 1, 1, h1.Length);
            hr1.Style.Font.Bold = true;
            hr1.Style.Fill.BackgroundColor = XLColor.FromHtml("#1565C0");
            hr1.Style.Font.FontColor = XLColor.White;

            int row = 2;
            foreach (var d in deliveries)
            {
                var itemsText = string.Join(", ", d.Items.Select(i => $"{i.ProductName} ({i.Size})"));
                ws1.Cell(row, 1).Value = d.ResidentName;
                ws1.Cell(row, 2).Value = d.RoomNumber;
                ws1.Cell(row, 3).Value = itemsText;
                ws1.Cell(row, 4).Value = d.DeliveredBy;
                ws1.Cell(row, 5).Value = d.DeliveredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
                ws1.Cell(row, 6).Value = d.Notes ?? "";
                if (row % 2 == 0)
                    ws1.Range(row, 1, row, h1.Length).Style.Fill.BackgroundColor = XLColor.FromHtml("#f5f5f5");
                row++;
            }
            ws1.Columns().AdjustToContents();
            ws1.SheetView.FreezeRows(1);

            // ── Sheet 2: Resumo por residente ─────────────────────────────────
            var ws2 = wb.Worksheets.Add("Resumo");
            string[] h2 = ["Residente", "Quarto", "Nº entregas", "Última entrega"];
            for (int i = 0; i < h2.Length; i++) ws2.Cell(1, i + 1).Value = h2[i];
            var hr2 = ws2.Range(1, 1, 1, h2.Length);
            hr2.Style.Font.Bold = true;
            hr2.Style.Fill.BackgroundColor = XLColor.FromHtml("#1565C0");
            hr2.Style.Font.FontColor = XLColor.White;

            var summary = deliveries
                .GroupBy(d => d.ResidentId)
                .Select(g => (
                    Name:  g.First().ResidentName,
                    Room:  g.First().RoomNumber,
                    Count: g.Count(),
                    Last:  g.Max(d => d.DeliveredAt).ToLocalTime().ToString("dd/MM/yyyy HH:mm")))
                .OrderBy(s => s.Room);

            row = 2;
            foreach (var s in summary)
            {
                ws2.Cell(row, 1).Value = s.Name;
                ws2.Cell(row, 2).Value = s.Room;
                ws2.Cell(row, 3).Value = s.Count;
                ws2.Cell(row, 4).Value = s.Last;
                if (row % 2 == 0)
                    ws2.Range(row, 1, row, h2.Length).Style.Fill.BackgroundColor = XLColor.FromHtml("#f5f5f5");
                row++;
            }
            ws2.Columns().AdjustToContents();
            ws2.SheetView.FreezeRows(1);

            var path = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
                $"AMRO_Kits_{_kitExportYear}.xlsx");

            wb.SaveAs(path);
            Snackbar.Add("Ficheiro guardado no Ambiente de Trabalho.", Severity.Success);
            await Launcher.Default.OpenAsync(new Uri($"file:///{path.Replace('\\', '/')}"));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao exportar: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadProducts()
    {
        _error = null;
        _loading = true;
        StateHasChanged();
        try
        {
            _products = await ProductSvc.GetAllAsync(_search, _typeFilter, _lowStockOnly);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task OpenSaleDialog(SizeVariant variant)
    {
        var parameters = new DialogParameters<StockAdjustDialog>
        {
            { x => x.VariantItem, variant },
            { x => x.DefaultReason, MovementReason.Sale },
            { x => x.DefaultAmount, -1 }
        };
        var dialog = await DialogService.ShowAsync<StockAdjustDialog>("Registar Saída", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadProducts();
    }

    private async Task QuickRestock(SizeVariant variant)
    {
        await StockSvc.AdjustStockAsync(variant.Id, 1, MovementReason.Restock);
        variant.Quantity += 1;
        StateHasChanged();
        Snackbar.Add($"{variant.Size} reposto.", Severity.Success);
    }

    private async Task OpenAdjustDialog(SizeVariant variant)
    {
        var parameters = new DialogParameters<StockAdjustDialog>
        {
            { x => x.VariantItem, variant }
        };
        var dialog = await DialogService.ShowAsync<StockAdjustDialog>("Ajustar Stock", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadProducts();
    }

    private async Task OpenTradeDialog()
    {
        var parameters = new DialogParameters<TradeDialog>
        {
            { x => x.AllProducts, _products }
        };
        var dialog = await DialogService.ShowAsync<TradeDialog>("Troca de Artigos", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadProducts();
    }

    private async Task OpenCampaignDialog(Product product)
    {
        var parameters = new DialogParameters<ProductCampaignDialog> { { x => x.Product, product } };
        await DialogService.ShowAsync<ProductCampaignDialog>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, NoHeader = true });
    }

    private async Task DeleteProduct(Product product)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Eliminar Produto",
            $"Eliminar '{product.Name}' e todos os dados de stock associados?",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmed == true)
        {
            await ProductSvc.DeleteAsync(product.Id);
            _products.Remove(product);
            Snackbar.Add($"'{product.Name}' eliminado.", Severity.Info);
            StateHasChanged();
        }
    }
}
