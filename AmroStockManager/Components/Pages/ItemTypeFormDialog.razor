@inject GeneralItemService ItemSvc
@inject AuditLogService AuditSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(string.IsNullOrEmpty(Item.Id) ? "Adicionar Artigo" : "Editar Artigo")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="Item.Name"
                              Label="Nome do Artigo"
                              Required="true"
                              RequiredError="Obrigatório"
                              FullWidth="true"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int"
                                 @bind-Value="Item.TotalQuantity"
                                 Label="Quantidade Total"
                                 Min="1"
                                 FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Item.Description"
                              Label="Descrição (opcional)"
                              FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public GeneralItem Item { get; set; } = null!;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Item.Name))
        {
            Snackbar.Add("O nome é obrigatório.", Severity.Warning);
            return;
        }
        try
        {
            var isNew = string.IsNullOrEmpty(Item.Id);
            await ItemSvc.AddOrUpdateItemAsync(Item);
            await LogAsync(isNew ? "Artigo adicionado" : "Artigo editado",
                $"'{Item.Name}' · {Item.TotalQuantity} unid.");
            Snackbar.Add("Guardado.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

    private async Task LogAsync(string action, string? details = null)
    {
        try { await AuditSvc.LogAsync(action, details); } catch { }
    }

    private void Cancel() => MudDialog.Cancel();
}
