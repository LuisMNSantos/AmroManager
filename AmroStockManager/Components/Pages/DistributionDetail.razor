@page "/distribuicoes/{CampaignId}"
@inject DistributionService DistribSvc
@inject ResidentService ResidentSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<div class="d-flex align-center gap-2 mb-4 flex-wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/products"))" />
    <MudText Typo="Typo.h4" Style="flex:1;">@(_campaign?.Name ?? "Distribuição")</MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        <b>Erro ao carregar dados:</b> @_error
        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Load" Class="ml-2">
            Tentar novamente
        </MudButton>
    </MudAlert>
}
else if (_campaign is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Artigo</MudText>
                <MudText Typo="Typo.body1"><b>@_campaign.VariantLabel</b></MudText>
                @if (_campaign.QuantityPerRoom > 1)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_campaign.QuantityPerRoom unidades por quarto</MudText>
                }
                @if (!string.IsNullOrEmpty(_campaign.Notes))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-style:italic;" Class="mt-1">
                        @_campaign.Notes
                    </MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Progresso</MudText>
                <MudProgressLinear Value="@_campaign.ProgressPct" Color="Color.Success"
                                   Rounded="true" Size="Size.Large" Class="mb-1" />
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.caption">@_campaign.DeliveredCount de @_campaign.TotalRooms entregues</MudText>
                    @if (_campaign.PendingCount > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@_campaign.PendingCount em falta</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success">Completo!</MudText>
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <div class="d-flex align-center gap-2 mb-2 flex-wrap">
        <MudText Typo="Typo.h6" Style="flex:1;">Por Entregar (@Pending.Count)</MudText>
        @if (_selected.Count > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.DoneAll"
                       Disabled="_working"
                       OnClick="BulkDeliver">
                Marcar @_selected.Count como entregue@(_selected.Count != 1 ? "s" : "")
            </MudButton>
        }
        @if (Pending.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleSelectAll">
                @(_selected.Count == Pending.Count ? "Desselecionar tudo" : "Selecionar tudo")
            </MudButton>
        }
    </div>

    @if (Pending.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Todos os quartos já foram entregues!</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="overflow-hidden mb-5">
            @foreach (var rec in Pending)
            {
                var record     = rec;
                var resName    = _residentByRoom.TryGetValue(rec.RoomNumber.ToUpper(), out var rn) ? rn : null;
                var isSelected = _selected.Contains(rec.Id);
                <div class="d-flex align-center gap-3 px-4 py-2"
                     style="border-bottom:1px solid rgba(0,0,0,0.07); cursor:pointer;"
                     @onclick="@(() => ToggleSelect(record.Id))">
                    <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                             Color="Color.Success" Size="Size.Small" />
                    <div style="flex:1;">
                        <MudText Typo="Typo.body2">
                            <b>Quarto #@rec.RoomNumber</b>
                            @if (resName is not null)
                            {
                                <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary"> — @resName</MudText>
                            }
                        </MudText>
                    </div>
                    <span @onclick:stopPropagation="true">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                   Disabled="_working"
                                   OnClick="@(() => Deliver(record))">
                            Entregar
                        </MudButton>
                    </span>
                </div>
            }
        </MudPaper>
    }

    @if (Delivered.Count > 0)
    {
        <div class="d-flex align-center gap-2 mb-2" style="cursor:pointer;"
             @onclick="@(() => _showDelivered = !_showDelivered)">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
            <MudText Typo="Typo.h6" Style="flex:1;">Entregues (@Delivered.Count)</MudText>
            <MudIcon Icon="@(_showDelivered ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Size="Size.Small" Color="Color.Default" />
        </div>
        @if (_showDelivered)
        {
            <MudPaper Elevation="1" Class="overflow-hidden" Style="opacity:0.85;">
                @foreach (var rec in Delivered)
                {
                    var resName = _residentByRoom.TryGetValue(rec.RoomNumber.ToUpper(), out var rn) ? rn : null;
                    <div class="d-flex align-center gap-3 px-4 py-2"
                         style="border-bottom:1px solid rgba(0,0,0,0.07);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        <div style="flex:1;">
                            <MudText Typo="Typo.body2">
                                <b>Quarto #@rec.RoomNumber</b>
                                @if (resName is not null)
                                {
                                    <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary"> — @resName</MudText>
                                }
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @rec.DistributedAt?.ToLocalTime().ToString("dd/MM HH:mm")
                            </MudText>
                        </div>
                    </div>
                }
            </MudPaper>
        }
    }
}

@code {
    [Parameter] public string CampaignId { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _working;
    private bool _showDelivered;
    private string? _error;
    private DistributionCampaign? _campaign;
    private Dictionary<string, string> _residentByRoom = [];
    private HashSet<string> _selected = [];

    private List<DistributionRecord> Pending   => _campaign?.Records.Where(r => !r.IsDelivered).ToList() ?? [];
    private List<DistributionRecord> Delivered => _campaign?.Records.Where(r =>  r.IsDelivered).ToList() ?? [];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading  = true;
        _error    = null;
        _selected = [];
        try
        {
            var campaignTask  = DistribSvc.GetWithRecordsAsync(CampaignId);
            var residentsTask = ResidentSvc.GetAllAsync();
            await Task.WhenAll(campaignTask, residentsTask);

            _campaign       = campaignTask.Result;
            _residentByRoom = residentsTask.Result
                .Where(r => !string.IsNullOrEmpty(r.RoomNumber))
                .ToDictionary(r => r.RoomNumber.ToUpper(), r => r.Name);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void ToggleSelect(string recordId)
    {
        if (!_selected.Remove(recordId))
            _selected.Add(recordId);
    }

    private void ToggleSelectAll()
    {
        var pendingIds = Pending.Select(r => r.Id).ToList();
        if (_selected.Count == pendingIds.Count)
            _selected.Clear();
        else
            _selected = [..pendingIds];
    }

    private async Task Deliver(DistributionRecord record)
    {
        if (_campaign is null) return;
        _working = true;
        try
        {
            await DistribSvc.DeliverAsync(record.Id, _campaign.Id, record.RoomNumber);
            Snackbar.Add($"Quarto #{record.RoomNumber} marcado como entregue.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add($"Erro: {ex.Message}", Severity.Error); }
        finally { _working = false; }
    }

    private async Task BulkDeliver()
    {
        if (_campaign is null || _selected.Count == 0) return;
        _working = true;
        try
        {
            var ids    = _selected.ToList();
            var suffix = ids.Count != 1 ? "s" : "";
            await DistribSvc.BulkDeliverAsync(ids, _campaign.Id);
            Snackbar.Add($"{ids.Count} quarto{suffix} marcado{suffix} como entregue{suffix}.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add($"Erro: {ex.Message}", Severity.Error); }
        finally { _working = false; }
    }
}
