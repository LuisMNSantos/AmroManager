@* Inline reservation card used by Calendar.razor *@

@{
    var state = GetState();
    var isMultiDay = Reservation.StartTime.ToLocalTime().Date != Reservation.EndTime.ToLocalTime().Date;
    var timeLabel  = isMultiDay
        ? $"{Reservation.StartTime.ToLocalTime():HH:mm (dd/MM)} – {Reservation.EndTime.ToLocalTime():HH:mm (dd/MM)}"
        : $"{Reservation.StartTime.ToLocalTime():HH:mm} – {Reservation.EndTime.ToLocalTime():HH:mm}";
}

<MudPaper Outlined="true" Class="pa-3 mb-2" Style="@(state == "Concluída" ? "opacity:0.65" : "")">
    <div class="d-flex align-start justify-space-between gap-2">
        <div style="flex:1; min-width:0;">
            <div class="d-flex align-center gap-2 mb-1">
                @switch (state)
                {
                    case "Agendada":
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Agendada</MudChip>
                        break;
                    case "Em Curso":
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Em Curso</MudChip>
                        break;
                    default:
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Concluída</MudChip>
                        break;
                }
            </div>
            <MudText Typo="Typo.body1">
                <b>#@Reservation.RoomNumber@(ResidentName is not null ? $" - {ResidentName}" : "")</b>
                <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary">
                    — @Reservation.ReservedBy
                </MudText>
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@timeLabel</MudText>
            @if (!string.IsNullOrEmpty(Reservation.Notes))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    @Reservation.Notes
                </MudText>
            }
        </div>

        <div class="d-flex flex-column align-end gap-1">
            @if (state == "Agendada")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Key"
                           OnClick="@(() => OnActivate.InvokeAsync(Reservation))">
                    Activar
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => OnCancel.InvokeAsync(Reservation))">
                    Cancelar
                </MudButton>
            }
            else if (state == "Em Curso")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AssignmentReturn"
                           OnClick="@(() => OnComplete.InvokeAsync(Reservation))">
                    Devolver Cartão
                </MudButton>
            }
        </div>
    </div>
</MudPaper>

@code {
    [Parameter] public Reservation Reservation { get; set; } = null!;
    [Parameter] public string? ResidentName { get; set; }
    [Parameter] public EventCallback<Reservation> OnActivate { get; set; }
    [Parameter] public EventCallback<Reservation> OnComplete { get; set; }
    [Parameter] public EventCallback<Reservation> OnCancel   { get; set; }

    private string GetState()
    {
        if (!Reservation.IsActivated) return "Agendada";
        if (!Reservation.IsCompleted) return "Em Curso";
        return "Concluída";
    }
}
