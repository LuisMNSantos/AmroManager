@using Microsoft.Maui.ApplicationModel
@inject DeliveryService DeliverySvc
@inject ResidentService ResidentSvc
@inject AuditLogService AuditSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Registar Chegada</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <!-- Type selector -->
            <MudItem xs="12">
                <div class="d-flex mb-1" style="border:1px solid rgba(0,0,0,0.23); border-radius:4px; overflow:hidden;">
                    <MudButton FullWidth="true"
                               Color="@(_type == DeliveryType.Encomenda ? Color.Warning : Color.Default)"
                               Variant="@(_type == DeliveryType.Encomenda ? Variant.Filled : Variant.Text)"
                               StartIcon="@Icons.Material.Filled.Inventory2"
                               OnClick="@(() => _type = DeliveryType.Encomenda)"
                               Style="border-radius:0; flex:1;">
                        Encomenda
                    </MudButton>
                    <div style="width:1px; background:rgba(0,0,0,0.23);"></div>
                    <MudButton FullWidth="true"
                               Color="@(_type == DeliveryType.Carta ? Color.Info : Color.Default)"
                               Variant="@(_type == DeliveryType.Carta ? Variant.Filled : Variant.Text)"
                               StartIcon="@Icons.Material.Filled.Mail"
                               OnClick="@(() => _type = DeliveryType.Carta)"
                               Style="border-radius:0; flex:1;">
                        Carta
                    </MudButton>
                </div>
            </MudItem>

            <!-- Room number with autocomplete -->
            <MudItem xs="12" sm="7">
                <MudAutocomplete T="string"
                                 @bind-Value="_roomInput"
                                 Label="Quarto"
                                 Placeholder="ex: 405, 404A"
                                 SearchFunc="SearchRooms"
                                 CoerceText="true"
                                 Immediate="true"
                                 MinimumLength="1"
                                 Required="true"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.MeetingRoom"
                                 FullWidth="true"
                                 AutoFocus="true" />
            </MudItem>

            <!-- Quantity -->
            <MudItem xs="12" sm="5">
                <MudNumericField T="int"
                                 @bind-Value="_quantity"
                                 Label="Quantidade"
                                 Min="1"
                                 Max="99"
                                 FullWidth="true" />
            </MudItem>

            <!-- Registered by -->
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string"
                                 @bind-Value="_registeredBy"
                                 Label="Registado por"
                                 SearchFunc="SearchCollaborators"
                                 Strict="false"
                                 CoerceText="true"
                                 Immediate="true"
                                 FullWidth="true" />
            </MudItem>

            <!-- Notes -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_notes"
                              Label="Notas (opcional)"
                              Placeholder="ex: frágil, tamanho grande…"
                              FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="Confirm">
            Registar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public DeliveryType DefaultType { get; set; } = DeliveryType.Encomenda;

    private DeliveryType _type;
    private string _roomInput     = string.Empty;
    private string _registeredBy  = string.Empty;
    private int _quantity = 1;
    private string? _notes;
    private List<string> _collaborators = [];

    protected override void OnParametersSet() => _type = DefaultType;

    protected override async Task OnInitializedAsync()
    {
        var all = await ResidentSvc.GetAllAsync();
        _collaborators = all.Where(r => r.IsCollaborator).Select(r => r.Name).ToList();
    }

    private Task<IEnumerable<string>> SearchRooms(string value, CancellationToken ct)
        => ResidentSvc.GetSuggestionsAsync(value);

    private Task<IEnumerable<string>> SearchCollaborators(string value, CancellationToken ct)
    {
        IEnumerable<string> result = string.IsNullOrWhiteSpace(value)
            ? _collaborators
            : _collaborators.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private async Task Confirm()
    {
        var roomNumber = ResidentService.ParseRoomNumber(_roomInput);
        if (string.IsNullOrWhiteSpace(roomNumber))
        {
            Snackbar.Add("Indique o número do quarto.", Severity.Warning);
            return;
        }

        try
        {
            var registeredBy = string.IsNullOrWhiteSpace(_registeredBy) ? null : _registeredBy.Trim();
            await DeliverySvc.RegisterAsync(_type, roomNumber, _quantity, _notes, registeredBy);

            var label = _type == DeliveryType.Encomenda ? "Encomenda" : "Carta";
            Snackbar.Add($"{label} para o quarto {roomNumber} registada.", Severity.Success);

            // Get resident for WhatsApp notification and audit log
            var resident = await ResidentSvc.GetByRoomAsync(roomNumber);
            var resName  = resident is not null ? $" · {resident.Name}" : "";
            var qtyPart  = _quantity > 1 ? $" · {_quantity} unid." : "";
            var byPart   = registeredBy is not null ? $" · por {registeredBy}" : "";
            var notesPart = !string.IsNullOrWhiteSpace(_notes) ? $" — {_notes!.Trim()}" : "";
            await LogAsync($"{label} registada", $"#{roomNumber}{resName}{qtyPart}{byPart}{notesPart}");

            if (resident?.PhoneNumber is not null)
            {
                var send = await DialogService.ShowMessageBox(
                    "Notificar Residente",
                    $"Enviar notificação WhatsApp a {resident.Name} ({resident.PhoneNumber})?",
                    yesText: "Enviar", cancelText: "Não");
                if (send == true)
                    await OpenWhatsApp(resident, _type, _quantity);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

    private static async Task OpenWhatsApp(Resident resident, DeliveryType type, int qty)
    {
        var lang = MessageLocalizer.DetectLang(resident.PhoneNumber);
        var msg  = MessageLocalizer.DeliveryArrival(resident.Name, type, qty, DateTime.Now, lang);

        var phone = resident.PhoneNumber!
            .Replace("+", "").Replace(" ", "").Replace("-", "");

        var url = $"https://wa.me/{phone}?text={Uri.EscapeDataString(msg)}";
        await Launcher.Default.OpenAsync(new Uri(url));
    }

    private async Task LogAsync(string action, string? details = null)
    {
        try { await AuditSvc.LogAsync(action, details); } catch { }
    }

    private void Cancel() => MudDialog.Cancel();
}
