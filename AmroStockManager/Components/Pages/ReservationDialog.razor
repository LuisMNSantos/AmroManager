@inject ReservationService ReservaSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Nova Reserva</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="ReservationSpace" @bind-Value="_space" Label="Espaço" FullWidth="true">
                    <MudSelectItem Value="ReservationSpace.Cozinha">Cozinha MasterChef (08:00–22:00)</MudSelectItem>
                    <MudSelectItem Value="ReservationSpace.Cinema">Cinema</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_roomNumber"
                              Label="Número do Quarto"
                              Required="true"
                              RequiredError="Obrigatório"
                              Placeholder="ex: 405, 404A"
                              Immediate="true"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_reservedBy"
                              Label="Reservado Por"
                              Required="true"
                              RequiredError="Obrigatório"
                              Immediate="true"
                              FullWidth="true" />
            </MudItem>

            <!-- Start time -->
            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="_startTime"
                               Label="Hora de Início"
                               AmPm="false" />
            </MudItem>

            <!-- End time -->
            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="_endTime"
                               Label="Hora de Fim"
                               AmPm="false" />
            </MudItem>

            @if (_space == ReservationSpace.Cinema)
            {
                <MudItem xs="12">
                    <MudSelect T="int" @bind-Value="_endDayOffset" Label="Fim — dia" FullWidth="true">
                        <MudSelectItem Value="0">Mesmo dia (@Date.ToString("dd/MM"))</MudSelectItem>
                        <MudSelectItem Value="1">Dia seguinte (@Date.AddDays(1).ToString("dd/MM"))</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        O Cinema permite reservas que atravessam a meia-noite.
                    </MudAlert>
                </MudItem>
            }

            @if (_space == ReservationSpace.Cozinha)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Horário permitido: <b>08:00 – 22:00</b>.
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notas (opcional)" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    O cartão de acesso é entregue manualmente ao activar a reserva.
                </MudAlert>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">
            Criar Reserva
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public DateTime Date { get; set; } = DateTime.Today;
    [Parameter] public ReservationSpace DefaultSpace { get; set; } = ReservationSpace.Cozinha;

    private ReservationSpace _space;
    private string _roomNumber  = string.Empty;
    private string _reservedBy  = string.Empty;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private int _endDayOffset = 0;
    private string? _notes;

    protected override void OnParametersSet() => _space = DefaultSpace;

    private async Task Confirm()
    {
        if (string.IsNullOrWhiteSpace(_roomNumber) || string.IsNullOrWhiteSpace(_reservedBy))
        {
            Snackbar.Add("Número do quarto e responsável são obrigatórios.", Severity.Warning);
            return;
        }
        if (!_startTime.HasValue || !_endTime.HasValue)
        {
            Snackbar.Add("Indique a hora de início e de fim.", Severity.Warning);
            return;
        }

        if (_space == ReservationSpace.Cozinha)
        {
            if (_startTime.Value.Hours < 8)
            {
                Snackbar.Add("A Cozinha MasterChef só abre às 08:00.", Severity.Warning);
                return;
            }
            if (_endTime.Value.Hours > 22 || (_endTime.Value.Hours == 22 && _endTime.Value.Minutes > 0))
            {
                Snackbar.Add("A Cozinha MasterChef fecha às 22:00.", Severity.Warning);
                return;
            }
        }

        var endDate = Date.AddDays(_endDayOffset);
        if (_endDayOffset == 0 && _endTime <= _startTime)
        {
            Snackbar.Add("A hora de fim deve ser posterior à hora de início.", Severity.Warning);
            return;
        }

        var startDt = DateTime.SpecifyKind(Date.Date    + _startTime.Value, DateTimeKind.Local);
        var endDt   = DateTime.SpecifyKind(endDate.Date + _endTime.Value,   DateTimeKind.Local);

        var (ok, error, _) = await ReservaSvc.CreateAsync(_space, _roomNumber, _reservedBy, startDt, endDt, _notes);
        if (!ok)
        {
            Snackbar.Add(error ?? "Não foi possível criar a reserva.", Severity.Error);
            return;
        }

        Snackbar.Add("Reserva criada. Active-a na altura certa para emitir o cartão.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
