@inject ReservationService ReservaSvc
@inject ResidentService ResidentSvc
@inject AuditLogService AuditSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using Microsoft.Maui.ApplicationModel

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Nova Reserva</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="ReservationSpace" @bind-Value="_space" Label="Espaço" FullWidth="true">
                    <MudSelectItem Value="ReservationSpace.Cozinha">Cozinha MasterChef (08:00–22:00)</MudSelectItem>
                    <MudSelectItem Value="ReservationSpace.Cinema">Cinema</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string"
                                 @bind-Value="_roomInput"
                                 Label="Número do Quarto"
                                 Placeholder="ex: 405, 404A"
                                 SearchFunc="SearchRooms"
                                 CoerceText="true"
                                 Immediate="true"
                                 MinimumLength="1"
                                 Required="true"
                                 FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string"
                                 @bind-Value="_reservedBy"
                                 Label="Reservado Por"
                                 Required="true"
                                 RequiredError="Obrigatório"
                                 SearchFunc="SearchCollaborators"
                                 Strict="false"
                                 CoerceText="true"
                                 Immediate="true"
                                 FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="_startTime" Label="Hora de Início" AmPm="false" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="_endTime" Label="Hora de Fim" AmPm="false" />
            </MudItem>

            @if (_space == ReservationSpace.Cinema)
            {
                <MudItem xs="12">
                    <MudSelect T="int" @bind-Value="_endDayOffset" Label="Fim — dia" FullWidth="true">
                        <MudSelectItem Value="0">Mesmo dia (@Date.ToString("dd/MM"))</MudSelectItem>
                        <MudSelectItem Value="1">Dia seguinte (@Date.AddDays(1).ToString("dd/MM"))</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        O Cinema permite reservas que atravessam a meia-noite.
                    </MudAlert>
                </MudItem>
            }

            @if (_space == ReservationSpace.Cozinha)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Horário permitido: <b>08:00 – 22:00</b>.
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notas (opcional)" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    O cartão de acesso é entregue manualmente ao activar a reserva.
                </MudAlert>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">
            Criar Reserva
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public DateTime Date { get; set; } = DateTime.Today;
    [Parameter] public ReservationSpace DefaultSpace { get; set; } = ReservationSpace.Cozinha;

    private ReservationSpace _space;
    private string _roomInput  = string.Empty;
    private string _reservedBy = string.Empty;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private int _endDayOffset  = 0;
    private string? _notes;
    private List<string> _collaborators = [];

    protected override void OnParametersSet() => _space = DefaultSpace;

    protected override async Task OnInitializedAsync()
    {
        var all = await ResidentSvc.GetAllAsync();
        _collaborators = all.Where(r => r.IsCollaborator).Select(r => r.Name).ToList();
    }

    private Task<IEnumerable<string>> SearchRooms(string value, CancellationToken ct)
        => ResidentSvc.GetSuggestionsAsync(value);

    private Task<IEnumerable<string>> SearchCollaborators(string value, CancellationToken ct)
    {
        IEnumerable<string> result = string.IsNullOrWhiteSpace(value)
            ? _collaborators
            : _collaborators.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private async Task Confirm()
    {
        var roomNumber = ResidentService.ParseRoomNumber(_roomInput);
        if (string.IsNullOrWhiteSpace(roomNumber) || string.IsNullOrWhiteSpace(_reservedBy))
        {
            Snackbar.Add("Número do quarto e responsável são obrigatórios.", Severity.Warning);
            return;
        }
        if (!_startTime.HasValue || !_endTime.HasValue)
        {
            Snackbar.Add("Indique a hora de início e de fim.", Severity.Warning);
            return;
        }

        if (_space == ReservationSpace.Cozinha)
        {
            if (_startTime.Value.Hours < 8)
            {
                Snackbar.Add("A Cozinha MasterChef só abre às 08:00.", Severity.Warning);
                return;
            }
            if (_endTime.Value.Hours > 22 || (_endTime.Value.Hours == 22 && _endTime.Value.Minutes > 0))
            {
                Snackbar.Add("A Cozinha MasterChef fecha às 22:00.", Severity.Warning);
                return;
            }
        }

        if (_endDayOffset == 0 && _endTime <= _startTime)
        {
            Snackbar.Add("A hora de fim deve ser posterior à hora de início.", Severity.Warning);
            return;
        }

        var endDate = Date.AddDays(_endDayOffset);
        var startDt = DateTime.SpecifyKind(Date.Date    + _startTime.Value, DateTimeKind.Local);
        var endDt   = DateTime.SpecifyKind(endDate.Date + _endTime.Value,   DateTimeKind.Local);

        var (ok, error, _) = await ReservaSvc.CreateAsync(_space, roomNumber, _reservedBy, startDt, endDt, _notes);
        if (!ok)
        {
            Snackbar.Add(error ?? "Não foi possível criar a reserva.", Severity.Error);
            return;
        }

        var spaceLabel = _space == ReservationSpace.Cozinha ? "Cozinha MasterChef" : "Cinema";
        var byPart     = !string.IsNullOrWhiteSpace(_reservedBy) ? $" · {_reservedBy.Trim()}" : "";
        await LogAsync("Reserva criada",
            $"#{roomNumber}{byPart} · {spaceLabel} · {startDt.ToLocalTime():dd/MM HH:mm}–{endDt.ToLocalTime():HH:mm}");

        var resident = await ResidentSvc.GetByRoomAsync(roomNumber);
        if (resident?.PhoneNumber is not null)
        {
            var startLocal = startDt.ToLocalTime();
            var endLocal   = endDt.ToLocalTime();
            var lang       = MessageLocalizer.DetectLang(resident.PhoneNumber);
            var msg        = MessageLocalizer.Reservation(resident.Name, _space, startLocal, endLocal, lang);

            var send = await DialogService.ShowMessageBox(
                "Notificar por WhatsApp?",
                $"Enviar confirmação a {resident.Name} ({resident.PhoneNumber})?",
                yesText: "Abrir WhatsApp", cancelText: "Ignorar");

            if (send == true)
            {
                var phone = resident.PhoneNumber.Replace("+", "").Replace(" ", "");
                await Launcher.Default.OpenAsync(new Uri($"https://wa.me/{phone}?text={Uri.EscapeDataString(msg)}"));
            }
        }

        Snackbar.Add("Reserva criada. Active-a na altura certa para emitir o cartão.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task LogAsync(string action, string? details = null)
    {
        try { await AuditSvc.LogAsync(action, details); } catch { }
    }

    private void Cancel() => MudDialog.Cancel();
}
