@page "/whatsapp"
@inject WhatsAppService WhatsAppSvc
@inject IJSRuntime JS

<div @ref="_hostRef" style="width:100%;"></div>

@code {
    private ElementReference _hostRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await OpenAsync();
    }

    private async Task OpenAsync()
    {
        var rect = await JS.InvokeAsync<WaRect>("amro.getElementFillRect", _hostRef);
        WhatsAppSvc.OpenAt(null, null, rect.Left, rect.Top, rect.Width, rect.Height);
    }

    private record WaRect(double Left, double Top, double Width, double Height);
}
