@inject GeneralItemService ItemSvc
@inject ResidentService ResidentSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Emprestar — @ItemType.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Disponível: <b>@ItemType.AvailableCount</b> / @ItemType.TotalQuantity no total
                </MudAlert>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string"
                                 @bind-Value="_roomInput"
                                 Label="Número do Quarto"
                                 Placeholder="ex: 405, 404A"
                                 SearchFunc="SearchRooms"
                                 CoerceText="true"
                                 Immediate="true"
                                 MinimumLength="1"
                                 Required="true"
                                 FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_givenBy"
                              Label="Entregue Por (funcionário / pessoa)"
                              Required="true"
                              RequiredError="Obrigatório"
                              Immediate="true"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notas (opcional)" FullWidth="true" />
            </MudItem>

            @if (LinkedItem is not null)
            {
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        Artigo associado: @LinkedItem.Name
                    </MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        @LinkedItem.Name disponíveis: <b>@LinkedItem.AvailableCount</b>
                    </MudAlert>
                    <MudNumericField T="int"
                                     @bind-Value="_linkedQty"
                                     Label="@($"Quantidade de {LinkedItem.Name} a emprestar")"
                                     Min="0"
                                     Max="@LinkedItem.AvailableCount"
                                     FullWidth="true"
                                     HelperText="Deixe 0 para não emprestar" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">Emprestar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public GeneralItem ItemType { get; set; } = null!;
    [Parameter] public GeneralItem? LinkedItem { get; set; }

    private string _roomInput = string.Empty;
    private string _givenBy   = string.Empty;
    private string? _notes;
    private int _linkedQty = 0;

    protected override void OnParametersSet()
    {
        if (LinkedItem is not null)
            _linkedQty = Math.Min(1, LinkedItem.AvailableCount);
    }

    private Task<IEnumerable<string>> SearchRooms(string value, CancellationToken ct)
        => ResidentSvc.GetSuggestionsAsync(value);

    private async Task Confirm()
    {
        var roomNumber = ResidentService.ParseRoomNumber(_roomInput);
        if (string.IsNullOrWhiteSpace(roomNumber) || string.IsNullOrWhiteSpace(_givenBy))
        {
            Snackbar.Add("Número do quarto e entregue por são obrigatórios.", Severity.Warning);
            return;
        }

        var ok = await ItemSvc.LendItemAsync(ItemType.Id, roomNumber, _givenBy, _notes);
        if (!ok)
        {
            Snackbar.Add("Sem unidades disponíveis para emprestar.", Severity.Error);
            return;
        }

        if (LinkedItem is not null && _linkedQty > 0)
        {
            await ItemSvc.LendItemAsync(LinkedItem.Id, roomNumber, _givenBy,
                $"Com {ItemType.Name} — {_notes}".Trim(' ', '—'), _linkedQty);
        }

        var msg = LinkedItem is not null && _linkedQty > 0
            ? $"{ItemType.Name} e {_linkedQty}× {LinkedItem.Name} emprestados ao quarto {roomNumber}."
            : $"{ItemType.Name} emprestado ao quarto {roomNumber}.";

        Snackbar.Add(msg, Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
