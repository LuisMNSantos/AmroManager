@inject GeneralItemService ItemSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Emprestar — @ItemType.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Disponível: <b>@ItemType.AvailableCount</b> / @ItemType.TotalQuantity no total
                </MudAlert>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_roomNumber"
                              Label="Número do Quarto"
                              Required="true"
                              RequiredError="Obrigatório"
                              Placeholder="ex: 405, 404A"
                              Immediate="true"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_givenBy"
                              Label="Entregue Por (funcionário / pessoa)"
                              Required="true"
                              RequiredError="Obrigatório"
                              Immediate="true"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notas (opcional)" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">Emprestar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public GeneralItem ItemType { get; set; } = null!;

    private string _roomNumber = string.Empty;
    private string _givenBy = string.Empty;
    private string? _notes;

    private async Task Confirm()
    {
        if (string.IsNullOrWhiteSpace(_roomNumber) || string.IsNullOrWhiteSpace(_givenBy))
        {
            Snackbar.Add("Número do quarto e entregue por são obrigatórios.", Severity.Warning);
            return;
        }
        var ok = await ItemSvc.LendItemAsync(ItemType.Id, _roomNumber, _givenBy, _notes);
        if (!ok)
        {
            Snackbar.Add("Sem unidades disponíveis para emprestar.", Severity.Error);
            return;
        }
        Snackbar.Add($"{ItemType.Name} emprestado ao quarto {_roomNumber}.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
