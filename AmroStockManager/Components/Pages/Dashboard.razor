@page "/"
@inject StockService StockSvc
@inject GeneralItemService ItemSvc
@inject ReservationService ReservaSvc
@inject DeliveryService DeliverySvc
@inject ResidentService ResidentSvc
@inject SupabaseRealtimeService Realtime
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IDisposable
<div class="mb-4">
    <MudText Typo="Typo.h4">Painel</MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_alerts.Count > 0)
{
    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="border-left: 4px solid var(--mud-palette-error);">
        <div class="d-flex align-center gap-2" style="cursor:pointer;" @onclick="@(() => _alertsCollapsed = !_alertsCollapsed)">
            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Error" />
            <MudText Typo="Typo.subtitle1" Style="font-weight:700; flex:1;">
                @_alerts.Count alerta@(_alerts.Count > 1 ? "s" : "") que requer@(_alerts.Count == 1 ? "" : "em") ação
            </MudText>
            <MudIcon Icon="@(_alertsCollapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                     Color="Color.Default" Size="Size.Small" />
        </div>
        @if (!_alertsCollapsed)
        {
            @foreach (var alert in _alerts)
            {
                <div class="d-flex align-center gap-2 py-1 mt-1" style="border-top:1px solid rgba(0,0,0,0.06);">
                    <MudIcon Icon="@alert.Icon" Color="@alert.Color" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Style="flex:1;">@alert.Message</MudText>
                    @if (alert.NavigateTo is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   OnClick="@(() => Nav.NavigateTo(alert.NavigateTo))">
                            Ver
                        </MudButton>
                    }
                </div>
            }
        }
    </MudPaper>
}

@if (!_loading && _error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">
        <b>Erro ao carregar dados:</b><br />
        <span style="font-size:0.85em; word-break:break-all;">@_error</span>
        <div class="mt-2">
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadData">Tentar novamente</MudButton>
        </div>
    </MudAlert>
}
else
{
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">

        <!-- ═══════════════════════════════ TAB 1: PRODUTOS ═══════════════════════════════ -->
        <MudTabPanel Text="Produtos" Icon="@Icons.Material.Filled.Inventory2">

            <MudGrid Spacing="3" Class="mb-6">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="pa-5 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Total de Produtos</MudText>
                        <MudText Typo="Typo.h3"><b>@_stats.totalProducts</b></MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="pa-5 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Total em Stock</MudText>
                        <MudText Typo="Typo.h3"><b>@_stats.totalUnits</b></MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="2" Class="pa-5 d-flex flex-column align-center"
                              Style="@(_stats.lowStockCount > 0 ? "border-left:4px solid var(--mud-palette-error);" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Warning"
                                 Color="@(_stats.lowStockCount > 0 ? Color.Error : Color.Primary)"
                                 Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Alertas de Stock</MudText>
                        <MudText Typo="Typo.h3" Color="@(_stats.lowStockCount > 0 ? Color.Error : Color.Default)">
                            <b>@_stats.lowStockCount</b>
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_lowStockVariants.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    <b>@_lowStockVariants.Count</b> variante(s) com stock baixo.
                    <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo("/products?lowstock=1"))" Class="ml-2">
                        Ver Todos
                    </MudButton>
                </MudAlert>
                <MudTable Items="_lowStockVariants" Dense="true" Hover="true" Elevation="1" Class="mb-6">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Stock Baixo</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Produto</MudTh><MudTh>Tipo</MudTh><MudTh>Tamanho</MudTh><MudTh>Qtd.</MudTh><MudTh>Mínimo</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Product.Name</MudTd>
                        <MudTd>@context.Product.Type</MudTd>
                        <MudTd><MudChip T="string" Color="Color.Error" Size="Size.Small">@context.Size</MudChip></MudTd>
                        <MudTd><b>@context.Quantity</b></MudTd>
                        <MudTd>@context.MinStockAlert</MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.h6">Movimentos Recentes</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.FileDownload"
                           Variant="Variant.Outlined" Size="Size.Small" OnClick="ExportStockCsv">
                    Exportar CSV
                </MudButton>
            </div>
            @if (_movements.Count == 0)
            {
                <MudText Color="Color.Secondary">Ainda sem movimentos de stock.</MudText>
            }
            else
            {
                <MudTable Items="_movements" Dense="true" Hover="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Data</MudTh><MudTh>Produto</MudTh><MudTh>Tamanho</MudTh>
                        <MudTh>Quarto</MudTh><MudTh>Movimento</MudTh><MudTh>Motivo</MudTh><MudTh>Notas</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Date.ToLocalTime().ToString("dd/MM/yy HH:mm")</MudTd>
                        <MudTd>@context.SizeVariant.Product.Name</MudTd>
                        <MudTd>@context.SizeVariant.Size</MudTd>
                        <MudTd>
                            @if (!string.IsNullOrEmpty(context.RoomNumber))
                            {
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@context.RoomNumber</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@(context.ChangeAmount >= 0 ? Color.Success : Color.Error)" Size="Size.Small">
                                @(context.ChangeAmount >= 0 ? "+" : "")@context.ChangeAmount
                            </MudChip>
                        </MudTd>
                        <MudTd>@TraducirMotivo(context.Reason)</MudTd>
                        <MudTd>@context.Notes</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- ══════════════════════════ TAB 2: ARTIGOS & RESERVAS ══════════════════════════ -->
        <MudTabPanel Text="Artigos & Reservas" Icon="@Icons.Material.Filled.Category">
            @{
                var totalLoans    = _items.Sum(i => i.ActiveLoansCount);
                var kitchenCard   = _items.FirstOrDefault(i => i.Name == "Cartão de Acesso – Cozinha");
                var cinemaCard    = _items.FirstOrDefault(i => i.Name == "Cartão de Acesso – Cinema");
                var activeReserv  = _todayReservations.Count(r => r.IsActivated && !r.IsCompleted);
                var todayCount    = _todayReservations.Count;
            }

            <MudGrid Spacing="3" Class="mb-5">
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Warning" Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Em Empréstimo</MudText>
                        <MudText Typo="Typo.h3"><b>@totalLoans</b></MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Reservas Hoje</MudText>
                        <MudText Typo="Typo.h3"><b>@todayCount</b></MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center"
                              Style="@(kitchenCard?.AvailableCount == 0 ? "border-left:4px solid var(--mud-palette-warning);" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Restaurant"
                                 Color="@(kitchenCard?.AvailableCount > 0 ? Color.Success : Color.Warning)"
                                 Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Cartão Cozinha</MudText>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(kitchenCard?.AvailableCount > 0 ? Color.Success : Color.Warning)">
                            @(kitchenCard?.AvailableCount > 0 ? "Disponível" : "Emprestado")
                        </MudChip>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center"
                              Style="@(cinemaCard?.AvailableCount == 0 ? "border-left:4px solid var(--mud-palette-warning);" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Theaters"
                                 Color="@(cinemaCard?.AvailableCount > 0 ? Color.Success : Color.Warning)"
                                 Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Cartão Cinema</MudText>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(cinemaCard?.AvailableCount > 0 ? Color.Success : Color.Warning)">
                            @(cinemaCard?.AvailableCount > 0 ? "Disponível" : "Emprestado")
                        </MudChip>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Active loans -->
            @{ var activeLoans = _items.SelectMany(i => i.Loans.Where(l => !l.IsReturned).Select(l => (Item: i, Loan: l))).OrderByDescending(x => x.Loan.LoanDate).ToList(); }
            <MudText Typo="Typo.h6" Class="mb-2">Empréstimos Activos</MudText>
            @if (activeLoans.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">Nenhum artigo em empréstimo.</MudAlert>
            }
            else
            {
                <MudPaper Elevation="1" Class="overflow-hidden mb-5">
                    @foreach (var (item, loan) in activeLoans)
                    {
                        <div class="d-flex align-center gap-3 px-4 py-2" style="border-bottom:1px solid rgba(0,0,0,0.07);">
                            <div style="flex:1;">
                                <MudText Typo="Typo.body2">
                                    <b>@item.Name</b>
                                    <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary">
                                        → @RoomDisplay(loan.RoomNumber)
                                    </MudText>
                                    @if (loan.Quantity > 1) { <span style="font-size:0.8em"> · @loan.Quantity unid.</span> }
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @loan.LoanDate.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                </MudText>
                            </div>
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Em empréstimo</MudChip>
                        </div>
                    }
                </MudPaper>
            }

            <!-- Today's reservations -->
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.h6">Reservas de Hoje</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo("/calendario"))">
                    Ver Calendário
                </MudButton>
            </div>
            @if (_todayReservations.Count == 0)
            {
                <MudAlert Severity="Severity.Info">Sem reservas para hoje.</MudAlert>
            }
            else
            {
                <MudPaper Elevation="1" Class="overflow-hidden">
                    @foreach (var res in _todayReservations)
                    {
                        var spaceLabel = res.Space == ReservationSpace.Cozinha ? "Cozinha MasterChef" : "Cinema";
                        var resState   = !res.IsActivated ? "Agendada"
                                         : !res.IsCompleted ? "Em Curso" : "Concluída";
                        var resColor   = resState == "Em Curso" ? Color.Warning : resState == "Concluída" ? Color.Success : Color.Default;
                        <div class="d-flex align-center gap-3 px-4 py-2" style="border-bottom:1px solid rgba(0,0,0,0.07);">
                            <div style="flex:1;">
                                <MudText Typo="Typo.body2">
                                    <b>@spaceLabel</b>
                                    <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary">
                                        · @RoomDisplay(res.RoomNumber)
                                    </MudText>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @res.StartTime.ToLocalTime().ToString("HH:mm") – @res.EndTime.ToLocalTime().ToString("HH:mm")
                                </MudText>
                            </div>
                            <MudChip T="string" Color="@resColor" Size="Size.Small">@resState</MudChip>
                        </div>
                    }
                </MudPaper>
            }
        </MudTabPanel>

        <!-- ═══════════════════════════ TAB 3: ENCOMENDAS & CARTAS ═══════════════════════════ -->
        <MudTabPanel Text="Encomendas & Cartas" Icon="@Icons.Material.Filled.LocalShipping">

            <MudGrid Spacing="3" Class="mb-5">
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center"
                              Style="@(_deliveryStats.PendingPackages > 0 ? "border-left:4px solid var(--mud-palette-warning);" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Warning" Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Encomendas</MudText>
                        <MudText Typo="Typo.h3"><b>@_deliveryStats.PendingPackages</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">por levantar</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center"
                              Style="@(_deliveryStats.PendingLetters > 0 ? "border-left:4px solid var(--mud-palette-info);" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Mail" Color="Color.Info" Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Cartas</MudText>
                        <MudText Typo="Typo.h3"><b>@_deliveryStats.PendingLetters</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">por levantar</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Today" Color="Color.Primary" Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Chegaram hoje</MudText>
                        <MudText Typo="Typo.h3"><b>@_deliveryStats.ArrivedToday</b></MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-1" />
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Levantados hoje</MudText>
                        <MudText Typo="Typo.h3"><b>@_deliveryStats.CollectedToday</b></MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- Pending list (compact) -->
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.h6">Por Levantar</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           OnClick="@(() => Nav.NavigateTo("/encomendas"))">
                    Ver página
                </MudButton>
            </div>
            @if (_pendingDeliveries.Count == 0)
            {
                <MudAlert Severity="Severity.Success">Nenhuma encomenda ou carta por levantar.</MudAlert>
            }
            else
            {
                <MudPaper Elevation="1" Class="overflow-hidden">
                    @foreach (var d in _pendingDeliveries.Take(8))
                    {
                        var dIcon  = d.Type == DeliveryType.Encomenda ? Icons.Material.Filled.Inventory2 : Icons.Material.Filled.Mail;
                        var dColor = d.Type == DeliveryType.Encomenda ? Color.Warning : Color.Info;
                        var dLabel = d.Type == DeliveryType.Encomenda ? "Encomenda" : "Carta";
                        <div class="d-flex align-center gap-3 px-4 py-2" style="border-bottom:1px solid rgba(0,0,0,0.07);">
                            <MudIcon Icon="@dIcon" Color="@dColor" Size="Size.Small" />
                            <div style="flex:1;">
                                <MudText Typo="Typo.body2">
                                    <b>@RoomDisplay(d.RoomNumber)</b>
                                    <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary">
                                        · @dLabel @(d.Quantity > 1 ? $"· {d.Quantity} unid." : "")
                                    </MudText>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @d.ArrivedAt.ToLocalTime().ToString("dd/MM HH:mm")
                                </MudText>
                            </div>
                        </div>
                    }
                    @if (_pendingDeliveries.Count > 8)
                    {
                        <div class="pa-2 text-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                + @(_pendingDeliveries.Count - 8) mais — ver página de encomendas
                            </MudText>
                        </div>
                    }
                </MudPaper>
            }
        </MudTabPanel>

    </MudTabs>
}

@code {
    private record DashboardAlert(string Message, string Icon, Color Color, string? NavigateTo);

    private bool _loading = true;
    private string? _error;
    private List<DashboardAlert> _alerts = [];
    private bool _alertsCollapsed;

    // Tab 1 — Produtos
    private (int totalProducts, int totalUnits, int lowStockCount) _stats;
    private List<StockMovement> _movements = [];
    private List<SizeVariant> _lowStockVariants = [];

    // Tab 2 — Artigos & Reservas
    private List<GeneralItem> _items = [];
    private List<Reservation> _todayReservations = [];
    private Dictionary<string, Resident> _residentByRoom = [];

    // Tab 3 — Encomendas
    private DeliveryDashboardStats _deliveryStats = new(0, 0, 0, 0);
    private List<Delivery> _pendingDeliveries = [];

    protected override async Task OnInitializedAsync()
    {
        Realtime.TableChanged += OnTableChanged;
        await LoadData();
    }

    private static readonly HashSet<string> _watchedTables =
        ["reservations", "deliveries", "general_item_loans", "general_items", "products", "size_variants", "residents"];

    private void OnTableChanged(string table)
    {
        if (_watchedTables.Contains(table))
            InvokeAsync(LoadData);
    }

    public void Dispose() => Realtime.TableChanged -= OnTableChanged;

    private async Task LoadData()
    {
        _loading = true;
        _error   = null;
        try
        {
            await Task.WhenAll(
                Task.Run(async () => {
                    _stats            = await StockSvc.GetDashboardStatsAsync();
                    _movements        = await StockSvc.GetRecentMovementsAsync(15);
                    _lowStockVariants = await StockSvc.GetLowStockVariantsAsync();
                }),
                Task.Run(async () => {
                    _items             = await ItemSvc.GetAllWithLoansAsync();
                    _todayReservations = await ReservaSvc.GetByDateAsync(DateTime.Today);
                    var residents      = await ResidentSvc.GetAllAsync();
                    _residentByRoom    = residents
                        .Where(r => !string.IsNullOrEmpty(r.RoomNumber))
                        .GroupBy(r => r.RoomNumber.ToUpper())
                        .ToDictionary(g => g.Key, g => g.First());
                }),
                Task.Run(async () => {
                    _deliveryStats     = await DeliverySvc.GetDashboardStatsAsync();
                    _pendingDeliveries = await DeliverySvc.GetPendingAsync();
                })
            );
            await BuildAlertsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task BuildAlertsAsync()
    {
        _alerts = [];

        // Cartões de acesso não devolvidos após o fim da reserva
        var overdueCards = await ReservaSvc.GetOverdueCardsAsync(hoursThreshold: 2);
        foreach (var r in overdueCards)
        {
            var space = r.Space == ReservationSpace.Cozinha ? "Cozinha" : "Cinema";
            var end   = r.EndTime.ToLocalTime();
            _alerts.Add(new(
                $"Cartão {space} do quarto #{r.RoomNumber} não devolvido (fim: {end:HH:mm dd/MM})",
                Icons.Material.Filled.Key, Color.Error, "/calendario"));
        }

        // Encomendas há mais de 7 dias por levantar
        var stale = await DeliverySvc.GetStalePendingAsync(daysThreshold: 7);
        foreach (var d in stale)
        {
            var label = d.Type == DeliveryType.Encomenda ? "Encomenda" : "Carta";
            var days  = (int)(DateTime.UtcNow - d.ArrivedAt).TotalDays;
            _alerts.Add(new(
                $"{label} do quarto #{d.RoomNumber} há {days} dias por levantar",
                Icons.Material.Filled.LocalShipping, Color.Warning, "/encomendas"));
        }

        // Stock baixo
        foreach (var sv in _lowStockVariants)
        {
            _alerts.Add(new(
                $"Stock baixo: {sv.Product.Name} ({sv.Size}) — {sv.Quantity} un. (mín. {sv.MinStockAlert})",
                Icons.Material.Filled.Warning, Color.Warning, "/products"));
        }
    }

    private async Task ExportStockCsv()
    {
        try
        {
            var path = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
                $"stock_export_{DateTime.Now:yyyyMMdd_HHmmss}.csv");
            await StockSvc.ExportToCsvAsync(path);
            Snackbar.Add($"Exportado para: {path}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro na exportação: {ex.Message}", Severity.Error);
        }
    }

    private string RoomDisplay(string room) =>
        _residentByRoom.TryGetValue(room.ToUpper(), out var r)
            ? $"#{room} - {r.Name}"
            : $"#{room}";

    private static string TraducirMotivo(MovementReason r) => r switch
    {
        MovementReason.Sale         => "Venda",
        MovementReason.Restock      => "Reposição",
        MovementReason.Adjustment   => "Ajuste",
        MovementReason.Trade        => "Troca",
        MovementReason.Distribution => "Distribuição",
        _                           => r.ToString()
    };
}
