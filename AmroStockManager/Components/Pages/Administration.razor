@page "/administracao"
@using Microsoft.Maui.Storage
@using Microsoft.Maui.ApplicationModel
@using ClosedXML.Excel
@inject ResidentService ResidentSvc
@inject RoomService RoomSvc
@inject BisLoanService BisSvc
@inject PendingRegistrationService PendingRegSvc
@inject AuditLogService AuditSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<!-- ── PIN lock overlay ── -->
@if (!_unlocked)
{
    <div style="display:flex; justify-content:center; align-items:center; min-height:60vh;">
        <MudPaper Elevation="4" Class="pa-8" Style="width:340px; text-align:center;">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings"
                     Color="Color.Primary" Style="font-size:3rem;" Class="mb-2" />
            <MudText Typo="Typo.h6" Class="mb-1">Área Restrita</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Introduza o código de 4 dígitos
            </MudText>
            <MudTextField @bind-Value="_pinInput"
                          InputType="InputType.Password"
                          Placeholder="● ● ● ●"
                          MaxLength="4"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Style="letter-spacing:0.5em; font-size:1.4rem; text-align:center;"
                          @onkeydown="OnPinKey" />
            @if (_pinError)
            {
                <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-2">
                    Código incorreto. Tente novamente.
                </MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" OnClick="TryUnlock">
                Entrar
            </MudButton>
        </MudPaper>
    </div>
    return;
}

<!-- ── Main content ── -->
<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Administração</MudText>

    <div class="d-flex align-center gap-2">
        <MudButton StartIcon="@Icons.Material.Filled.PersonAdd"
                   Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => OpenResidentForm(null))">
            Novo Residente
        </MudButton>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                               Variant="Variant.Outlined"
                               Title="Mais opções" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.FileUpload" OnClick="ImportCsv">
                    Importar CSV
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Lock"
                             OnClick="@(() => _showChangePinForm = !_showChangePinForm)">
                    Alterar PIN
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.CleaningServices"
                             OnClick="@(async () => await OpenMaintenance())">
                    Manutenção
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.History"
                             OnClick="@(async () => await OpenAuditLog())">
                    Histórico
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.TableChart"
                             IconColor="Color.Success" OnClick="ExportExcel">
                    Exportar Excel
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.DeleteSweep"
                             IconColor="Color.Error" OnClick="ClearAll">
                    Limpar Lista
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</div>

<!-- Change PIN form -->
@if (_showChangePinForm)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3">Alterar Código de Acesso</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_newPin"
                              Label="Novo código (4 dígitos)"
                              InputType="InputType.Password"
                              MaxLength="4"
                              Immediate="true"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_confirmPin"
                              Label="Confirmar código"
                              InputType="InputType.Password"
                              MaxLength="4"
                              Immediate="true"
                              FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-end gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangePin">
                    Guardar
                </MudButton>
                <MudButton OnClick="@(() => _showChangePinForm = false)">Cancelar</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

<!-- Stats -->
<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="1" Class="pa-3 d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Residentes</MudText>
                <MudText Typo="Typo.h5"><b>@_residents.Count(r => !r.IsCollaborator)</b></MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="1" Class="pa-3 d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Secondary" />
            <div>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Colaboradores</MudText>
                <MudText Typo="Typo.h5"><b>@_residents.Count(r => r.IsCollaborator)</b></MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="1" Class="pa-3 d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Color="Color.Success" />
            <div>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Com telemóvel</MudText>
                <MudText Typo="Typo.h5"><b>@_residents.Count(r => !string.IsNullOrEmpty(r.PhoneNumber))</b></MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Elevation="1" Class="pa-3 d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Color="Color.Success" />
            <div>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Livres</MudText>
                <MudText Typo="Typo.h5"><b>@VacantCount</b></MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        <b>Erro ao carregar dados:</b> @_error
        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadResidents" Class="ml-2">Tentar novamente</MudButton>
    </MudAlert>
}

<!-- Pending registrations -->
<MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-left: 4px solid var(--mud-palette-warning);">
    <div class="d-flex align-center gap-2 mb-3">
        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Warning" />
        <MudText Typo="Typo.h6">Pedidos de Registo</MudText>
        @if (_pendingRegs.Count > 0)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@_pendingRegs.Count</MudChip>
        }
    </div>
    @if (_pendingRegs.Count == 0)
    {
        <MudText Color="Color.Secondary" Typo="Typo.body2">Sem pedidos pendentes.</MudText>
    }
    else
    {
        <MudTable Items="@_pendingRegs" Dense="true" Hover="false" Elevation="0">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Quarto</MudTh>
                <MudTh>Telemóvel</MudTh>
                <MudTh>Recebido</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudText><b>@context.Name</b></MudText></MudTd>
                <MudTd><MudText>@context.RoomNumber</MudText></MudTd>
                <MudTd><MudText Typo="Typo.body2">@(context.PhoneNumber ?? "—")</MudText></MudTd>
                <MudTd><MudText Typo="Typo.caption" Color="Color.Secondary">@context.RequestedAt.ToLocalTime().ToString("dd/MM HH:mm")</MudText></MudTd>
                <MudTd>
                    <div class="d-flex gap-1">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   OnClick="@(() => ApproveRegistration(context))">
                            Aprovar
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => RejectRegistration(context))">
                            Rejeitar
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<!-- CSV hint -->
<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    Formato CSV: <b>Nome, Quarto, Telemóvel, Colaborador</b> &nbsp;·&nbsp;
    Telemóvel em formato internacional (ex: +351912345678) &nbsp;·&nbsp;
    Colaborador: true/false &nbsp;·&nbsp;
    Importar substitui a lista inteira.
</MudAlert>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_residents.Count == 0 && _rooms.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        Nenhum residente ou colaborador na lista. Importe um ficheiro CSV para começar.
    </MudAlert>
}
else
{
    <!-- Search + BIS filter + Vacant filter -->
    <div class="d-flex align-center gap-3 mb-2 flex-wrap">
        <MudTextField @bind-Value="_search" Placeholder="Pesquisar nome ou quarto…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" FullWidth="true" Style="flex:1; min-width:160px;" />
        <MudChip T="string"
                 Color="@(_showBisOnly ? Color.Warning : Color.Default)"
                 Variant="@(_showBisOnly ? Variant.Filled : Variant.Outlined)"
                 Icon="@Icons.Material.Filled.CreditCard"
                 OnClick="@(() => { _showBisOnly = !_showBisOnly; if (_showBisOnly) _showVacantOnly = false; })"
                 Style="cursor:pointer; white-space:nowrap;">
            BIS em uso (@_activeBis.Count)
        </MudChip>
        <MudChip T="string"
                 Color="@(_showVacantOnly ? Color.Success : Color.Default)"
                 Variant="@(_showVacantOnly ? Variant.Filled : Variant.Outlined)"
                 Icon="@Icons.Material.Filled.MeetingRoom"
                 OnClick="@(() => { _showVacantOnly = !_showVacantOnly; if (_showVacantOnly) { _showBisOnly = false; _showRenewersOnly = false; } })"
                 Style="cursor:pointer; white-space:nowrap;">
            Livres (@VacantCount)
        </MudChip>
        <MudChip T="string"
                 Color="@(_showRenewersOnly ? Color.Tertiary : Color.Default)"
                 Variant="@(_showRenewersOnly ? Variant.Filled : Variant.Outlined)"
                 Icon="@Icons.Material.Filled.Autorenew"
                 OnClick="@(() => { _showRenewersOnly = !_showRenewersOnly; if (_showRenewersOnly) { _showBisOnly = false; _showVacantOnly = false; } })"
                 Style="cursor:pointer; white-space:nowrap;">
            Renovadores (@RenewerCount)
        </MudChip>
        <MudChip T="string"
                 Color="@(_hideCollaborators ? Color.Secondary : Color.Default)"
                 Variant="@(_hideCollaborators ? Variant.Filled : Variant.Outlined)"
                 Icon="@Icons.Material.Outlined.Badge"
                 OnClick="@(() => _hideCollaborators = !_hideCollaborators)"
                 Style="cursor:pointer; white-space:nowrap;">
            Ocultar colaboradores
        </MudChip>
    </div>

    <!-- Floor filter -->
    <div class="d-flex align-center gap-2 mb-3 flex-wrap">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">Piso:</MudText>
        <MudChip T="string"
                 Color="@(_floorFilter is null ? Color.Primary : Color.Default)"
                 Variant="@(_floorFilter is null ? Variant.Filled : Variant.Outlined)"
                 Size="Size.Small" OnClick="@(() => _floorFilter = null)"
                 Style="cursor:pointer;">
            Todos
        </MudChip>
        @foreach (var floor in AvailableFloors)
        {
            var f = floor;
            <MudChip T="string"
                     Color="@(_floorFilter == f ? Color.Primary : Color.Default)"
                     Variant="@(_floorFilter == f ? Variant.Filled : Variant.Outlined)"
                     Size="Size.Small" OnClick="@(() => _floorFilter = f)"
                     Style="cursor:pointer;">
                Piso @f
            </MudChip>
        }
    </div>

    <MudPaper Elevation="2" Class="overflow-hidden">
        <!-- Table header -->
        <div style="display:grid; grid-template-columns:90px 1fr 180px 140px 95px 175px 100px;
                    padding:8px 16px; background:var(--mud-palette-background-grey); border-bottom:1px solid rgba(0,0,0,0.12);">
            <MudText Typo="Typo.caption" Style="font-weight:700;">Quarto</MudText>
            <MudText Typo="Typo.caption" Style="font-weight:700;">Nome</MudText>
            <MudText Typo="Typo.caption" Style="font-weight:700;">Designação</MudText>
            <MudText Typo="Typo.caption" Style="font-weight:700;">Telemóvel</MudText>
            <MudText Typo="Typo.caption" Style="font-weight:700;">Tipo</MudText>
            <MudText Typo="Typo.caption" Style="font-weight:700;">Cartão BIS</MudText>
            <span></span>
        </div>

        @foreach (var row in Filtered)
        {
            var resident = row.Resident;
            var roomInfo = row.Room;
            var roomNumber = roomInfo?.Number ?? resident?.RoomNumber ?? "";
            var isVacant = resident is null;
            _activeBis.TryGetValue(roomNumber, out var bis);
            <div style="display:grid; grid-template-columns:90px 1fr 180px 140px 95px 175px 100px;
                        padding:10px 16px; border-bottom:1px solid rgba(0,0,0,0.06);
                        align-items:center; @(isVacant ? "background:rgba(76,175,80,0.04);" : "")">
                <MudText Typo="Typo.body2" Style="font-weight:600;">
                    @(string.IsNullOrEmpty(roomNumber) ? "—" : $"#{roomNumber}")
                </MudText>
                @if (isVacant)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style:italic;">—</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">@resident!.Name</MudText>
                }
                <MudTooltip Text="@(roomInfo?.Designation ?? "")" Delay="400">
                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                             Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block;">
                        @(roomInfo?.Designation ?? "—")
                    </MudText>
                </MudTooltip>
                @if (isVacant)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="@(resident!.PhoneNumber is null ? Color.Secondary : Color.Default)">
                        @(resident!.PhoneNumber ?? "—")
                    </MudText>
                }
                @if (isVacant)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success"
                             Icon="@Icons.Material.Filled.MeetingRoom">
                        Livre
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="@(resident!.IsCollaborator ? Color.Secondary : Color.Primary)">
                        @(resident!.IsCollaborator
                            ? (resident!.CollaboratorRole == "admin" ? "Administrador" : "Concierge")
                            : "Residente")
                    </MudChip>
                }

                <!-- BIS column -->
                @if (isVacant || string.IsNullOrEmpty(roomNumber))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                }
                else if (bis is null)
                {
                    <div class="d-flex align-center gap-1">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                 Icon="@Icons.Material.Filled.CreditCard">
                            Disponível
                        </MudChip>
                        <MudTooltip Text="Dar BIS">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCard"
                                           Color="Color.Warning" Size="Size.Small"
                                           OnClick="@(() => GiveBis(resident!))" />
                        </MudTooltip>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center gap-1">
                        <MudTooltip Text="@($"Dado por: {bis.GivenBy}\n{bis.LoanDate.ToLocalTime():dd/MM/yy HH:mm}")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                     Icon="@Icons.Material.Filled.CreditCard">
                                Em uso · @(bis.DaysOut == 0 ? "hoje" : $"{bis.DaysOut}d")
                            </MudChip>
                        </MudTooltip>
                        <MudTooltip Text="Receber BIS">
                            <MudIconButton Icon="@Icons.Material.Filled.AssignmentReturn"
                                           Color="Color.Success" Size="Size.Small"
                                           OnClick="@(() => ReturnBis(resident!, bis))" />
                        </MudTooltip>
                    </div>
                }

                <div class="d-flex gap-1 align-center justify-end">
                    @if (isVacant)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PersonAdd"
                                       Color="Color.Primary" Size="Size.Small"
                                       Title="Adicionar residente"
                                       OnClick="@(() => OpenResidentForm(null))" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary" Size="Size.Small"
                                       Title="Editar"
                                       OnClick="@(() => OpenResidentForm(resident!))" />
                        <MudIconButton Icon="@Icons.Material.Filled.PersonSearch"
                                       Color="Color.Default" Size="Size.Small"
                                       Title="Ver quarto"
                                       OnClick="@(() => OpenDetailDialog(resident!))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" Size="Size.Small"
                                       Title="Eliminar"
                                       OnClick="@(() => DeleteResident(resident!))" />
                    }
                </div>
            </div>
        }
    </MudPaper>
}

@code {
    private static bool _sessionUnlocked = false;

    private bool _unlocked = _sessionUnlocked;
    private bool _loading = true;
    private string? _error;
    private string _pinInput = string.Empty;
    private bool _pinError;
    private bool _showChangePinForm;
    private string _newPin = string.Empty;
    private string _confirmPin = string.Empty;
    private string _search = string.Empty;
    private bool _showBisOnly;
    private bool _showVacantOnly;
    private bool _showRenewersOnly;
    private bool _hideCollaborators;
    private int? _floorFilter;
    private List<Resident> _residents = [];
    private List<PendingRegistration> _pendingRegs = [];
    private Dictionary<string, Room> _rooms = [];
    private Dictionary<string, BisLoan> _activeBis = [];

    private record DisplayRow(Resident? Resident, Room? Room);

    private int RenewerCount => _residents.Count(r => r.IsRenewer && !r.IsCollaborator);

    private static int? GetFloor(string? room)
    {
        if (string.IsNullOrWhiteSpace(room) || !char.IsDigit(room[0])) return null;
        return room[0] - '0';
    }

    private int VacantCount
    {
        get
        {
            var occupied = _residents
                .Where(r => r.RoomNumber is not null)
                .Select(r => r.RoomNumber!.ToUpper())
                .ToHashSet();
            return _rooms.Keys.Count(k => !occupied.Contains(k.ToUpper()));
        }
    }

    private IEnumerable<int> AvailableFloors => _rooms.Keys
        .Select(k => GetFloor(k))
        .Where(f => f.HasValue)
        .Select(f => f!.Value)
        .Distinct()
        .OrderBy(f => f);

    private IEnumerable<DisplayRow> AllRows
    {
        get
        {
            var occupied = _residents
                .Where(r => r.RoomNumber is not null)
                .Select(r => r.RoomNumber!.ToUpper())
                .ToHashSet();

            var residentRows = _residents.Select(r =>
                new DisplayRow(r, _rooms.GetValueOrDefault(r.RoomNumber ?? "")));

            var vacantRows = _rooms.Values
                .Where(room => !occupied.Contains(room.Number.ToUpper()))
                .Select(room => new DisplayRow(null, room));

            return residentRows.Concat(vacantRows);
        }
    }

    private IEnumerable<DisplayRow> Filtered => AllRows
        .Where(row => !_showVacantOnly || row.Resident is null)
        .Where(row => !_hideCollaborators || !(row.Resident?.IsCollaborator ?? false))
        .Where(row => !_showRenewersOnly || (row.Resident?.IsRenewer ?? false))
        .Where(row => string.IsNullOrWhiteSpace(_search) ||
                      (row.Resident?.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                      (row.Room?.Number ?? row.Resident?.RoomNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(row => !_showBisOnly || _activeBis.ContainsKey(row.Room?.Number ?? row.Resident?.RoomNumber ?? ""))
        .Where(row => _floorFilter is null || GetFloor(row.Room?.Number ?? row.Resident?.RoomNumber) == _floorFilter)
        .OrderBy(row => row.Room?.Number ?? row.Resident?.RoomNumber ?? "zzz");

    protected override async Task OnInitializedAsync()
    {
        if (_unlocked) await LoadResidents();
        _loading = false;
    }

    private async Task TryUnlock()
    {
        if (ResidentSvc.VerifyPin(_pinInput))
        {
            _sessionUnlocked = true;
            _unlocked = true;
            _pinError = false;
            _loading = true;
            await LoadResidents();
            _loading = false;
        }
        else
        {
            _pinError = true;
            _pinInput = string.Empty;
        }
    }

    private async Task OnPinKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await TryUnlock();
    }

    private async Task LoadResidents()
    {
        _error = null;
        try
        {
            var residentsTask = ResidentSvc.GetAllAsync();
            var roomsTask     = RoomSvc.GetAllAsync();
            var bisTask       = BisSvc.GetAllActiveByRoomAsync();
            await Task.WhenAll(residentsTask, roomsTask, bisTask);
            _residents = residentsTask.Result;
            _rooms     = roomsTask.Result;
            _activeBis = bisTask.Result;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        try
        {
            _pendingRegs = await PendingRegSvc.GetAllAsync();
        }
        catch
        {
            _pendingRegs = [];
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ApproveRegistration(PendingRegistration reg)
    {
        var parameters = new DialogParameters<ApproveRegistrationDialog>
        {
            { x => x.Registration, reg }
        };
        var dialog = await DialogService.ShowAsync<ApproveRegistrationDialog>(
            string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, NoHeader = true });
        var result = await dialog.Result;
        if (result is { Canceled: true }) return;

        try
        {
            var (action, name, room, phone, existing) =
                ((string, string, string, string, Resident?))result!.Data!;

            if (action == "replace" && existing is not null)
            {
                await PendingRegSvc.ApproveAsReplaceAsync(reg, existing, name, room, phone);
                await LogAsync("Registo aprovado (substituição)", $"{name} → quarto {room.ToUpper()}");
            }
            else
            {
                await PendingRegSvc.ApproveAsNewAsync(reg, name, room, phone);
                await LogAsync("Registo aprovado", $"{name} → quarto {room.ToUpper()}");
            }

            _pendingRegs.Remove(reg);
            Snackbar.Add($"{name} adicionado ao quarto {room.ToUpper()}.", Severity.Success);
            await LoadResidents();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao aprovar: {ex.Message}", Severity.Error);
        }
    }

    private async Task RejectRegistration(PendingRegistration reg)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Rejeitar Pedido",
            $"Rejeitar o registo de '{reg.Name}' (quarto {reg.RoomNumber})?",
            yesText: "Rejeitar", cancelText: "Cancelar");
        if (confirmed != true) return;

        try
        {
            await PendingRegSvc.RejectAsync(reg.Id);
            _pendingRegs.Remove(reg);
            await LogAsync("Registo rejeitado", $"{reg.Name}, quarto {reg.RoomNumber}");
            Snackbar.Add("Pedido rejeitado.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao rejeitar: {ex.Message}", Severity.Error);
        }
    }

    private void ChangePin()
    {
        if (_newPin.Length != 4 || !_newPin.All(char.IsDigit))
        {
            Snackbar.Add("O código deve ter exatamente 4 dígitos.", Severity.Warning);
            return;
        }
        if (_newPin != _confirmPin)
        {
            Snackbar.Add("Os códigos não coincidem.", Severity.Warning);
            return;
        }
        ResidentSvc.SavePin(_newPin);
        _ = LogAsync("PIN alterado");
        Snackbar.Add("Código alterado com sucesso.", Severity.Success);
        _newPin = _confirmPin = string.Empty;
        _showChangePinForm = false;
    }

    private async Task ImportCsv()
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Selecionar ficheiro CSV",
                FileTypes = new FilePickerFileType(
                    new Dictionary<DevicePlatform, IEnumerable<string>>
                    {
                        { DevicePlatform.WinUI, [".csv"] }
                    })
            });

            if (result is null) return;

            var confirmed = await DialogService.ShowMessageBox(
                "Confirmar importação",
                "Importar este CSV irá substituir toda a lista atual. Continuar?",
                yesText: "Importar", cancelText: "Cancelar");
            if (confirmed != true) return;

            await using var stream = await result.OpenReadAsync();
            var (imported, skipped) = await ResidentSvc.ImportFromCsvAsync(stream);
            await LoadResidents();
            await LogAsync("CSV importado", $"{imported} entradas{(skipped > 0 ? $", {skipped} ignoradas" : "")}");
            Snackbar.Add($"{imported} entradas importadas.{(skipped > 0 ? $" {skipped} ignoradas." : "")}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao importar: {ex.Message}", Severity.Error);
        }
    }

