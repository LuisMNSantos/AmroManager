    private async Task ExportExcel()
    {
        try
        {
            using var wb = new XLWorkbook();
            var ws = wb.Worksheets.Add("Residentes");

            // Header
            string[] headers = ["Quarto", "Piso", "Nome", "Telemóvel", "Tipo", "Designação"];
            for (int i = 0; i < headers.Length; i++)
                ws.Cell(1, i + 1).Value = headers[i];

            var headerRange = ws.Range(1, 1, 1, headers.Length);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor = XLColor.FromHtml("#1565C0");
            headerRange.Style.Font.FontColor = XLColor.White;

            // Data
            int row = 2;
            foreach (var r in _residents.OrderBy(r => r.RoomNumber))
            {
                _rooms.TryGetValue(r.RoomNumber ?? "", out var roomInfo);
                ws.Cell(row, 1).Value = r.RoomNumber ?? "";
                ws.Cell(row, 2).Value = GetFloor(r.RoomNumber)?.ToString() ?? "";
                ws.Cell(row, 3).Value = r.Name;
                ws.Cell(row, 4).Value = r.PhoneNumber ?? "";
                ws.Cell(row, 5).Value = r.IsCollaborator
                    ? (r.CollaboratorRole == "admin" ? "Administrador" : "Concierge")
                    : "Residente";
                ws.Cell(row, 6).Value = roomInfo?.Designation ?? "";

                // Alternate row shading
                if (row % 2 == 0)
                    ws.Range(row, 1, row, headers.Length).Style.Fill.BackgroundColor = XLColor.FromHtml("#f5f5f5");

                row++;
            }

            ws.Columns().AdjustToContents();
            ws.SheetView.FreezeRows(1);

            var path = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
                $"AMRO_Residentes_{DateTime.Now:yyyyMMdd_HHmm}.xlsx");

            wb.SaveAs(path);

            await LogAsync("Export Excel", $"{_residents.Count} residentes exportados");
            Snackbar.Add($"Ficheiro guardado no Ambiente de Trabalho.", Severity.Success);
            await Launcher.Default.OpenAsync(new Uri($"file:///{path.Replace('\\', '/')}"));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao exportar: {ex.Message}", Severity.Error);
        }
    }

