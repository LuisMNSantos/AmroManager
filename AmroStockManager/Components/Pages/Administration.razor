    private async Task GiveBis(Resident resident)
    {
        var parameters = new DialogParameters<BisLoanDialog>
        {
            { x => x.RoomNumber,   resident.RoomNumber ?? "" },
            { x => x.ResidentName, resident.Name }
        };
        var dialog = await DialogService.ShowAsync<BisLoanDialog>("Dar Cartão BIS", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        var (givenBy, notes) = ((string, string?))result.Data!;
        var (success, error) = await BisSvc.LendAsync(resident.RoomNumber!, givenBy, notes);
        if (success)
        {
            await LogAsync("BIS entregue", $"Quarto #{resident.RoomNumber} ({resident.Name}) por {givenBy}");
            Snackbar.Add($"Cartão BIS entregue ao quarto #{resident.RoomNumber}.", Severity.Success);
            await LoadResidents();
        }
        else
        {
            Snackbar.Add(error ?? "Erro ao dar BIS.", Severity.Error);
        }
    }

    private async Task ReturnBis(Resident resident, BisLoan loan)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Receber Cartão BIS",
            $"Confirmar devolução do cartão BIS do quarto #{resident.RoomNumber} ({resident.Name})?",
            yesText: "Confirmar devolução", cancelText: "Cancelar");
        if (confirmed != true) return;

        await BisSvc.ReturnAsync(loan.Id);
        await LogAsync("BIS devolvido", $"Quarto #{resident.RoomNumber} ({resident.Name})");
        Snackbar.Add($"Cartão BIS do quarto #{resident.RoomNumber} devolvido.", Severity.Success);
        await LoadResidents();
    }
