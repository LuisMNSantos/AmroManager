@page "/general-items"
@inject GeneralItemService ItemSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Artigos Gerais</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="OpenAddDialog">
        Adicionar Artigo
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">Nenhum artigo encontrado.</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var item in _items)
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@item.Name</MudText>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(item))" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        <div class="d-flex gap-2 mb-3">
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                ✓ @item.AvailableCount disponível
                            </MudChip>
                            @if (item.ActiveLoansCount > 0)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">
                                    ↑ @item.ActiveLoansCount em empréstimo
                                </MudChip>
                            }
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">
                                Total: @item.TotalQuantity
                            </MudChip>
                        </div>

                        @if (item.ActiveLoansCount > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Empréstimos Ativos</MudText>
                            @foreach (var loan in item.Loans.Where(l => !l.IsReturned).OrderByDescending(l => l.LoanDate))
                            {
                                <MudPaper Outlined="true" Class="pa-2 mb-1 d-flex align-center justify-space-between">
                                    <div>
                                        <MudText Typo="Typo.body2">
                                            <b>Quarto @loan.RoomNumber</b>
                                            — por @loan.GivenBy
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @loan.LoanDate.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                            @if (!string.IsNullOrEmpty(loan.Notes))
                                            {
                                                <span> · @loan.Notes</span>
                                            }
                                        </MudText>
                                    </div>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="@(() => ReturnItem(loan))">
                                        Devolver
                                    </MudButton>
                                </MudPaper>
                            }
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton StartIcon="@Icons.Material.Filled.ArrowUpward"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@(!item.HasAvailable)"
                                   OnClick="@(() => OpenLendDialog(item))">
                            Emprestar
                        </MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.History"
                                   Variant="Variant.Text"
                                   Size="Size.Small"
                                   OnClick="@(() => ToggleHistory(item.Id))">
                            Histórico
                        </MudButton>
                    </MudCardActions>

                    @if (_expandedHistoryId == item.Id)
                    {
                        <MudDivider />
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Histórico de Empréstimos</MudText>
                            @if (!_historyCache.TryGetValue(item.Id, out var history) || history.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Ainda sem histórico.</MudText>
                            }
                            else
                            {
                                @foreach (var loan in history)
                                {
                                    <MudPaper Outlined="true" Class="pa-2 mb-1"
                                              Style="@(loan.IsReturned ? "opacity:0.6" : "")">
                                        <div class="d-flex align-center justify-space-between">
                                            <MudText Typo="Typo.body2">
                                                <b>Quarto @loan.RoomNumber</b> · por @loan.GivenBy
                                            </MudText>
                                            @if (loan.IsReturned)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Devolvido</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">Em Empréstimo</MudChip>
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Emprestado: @loan.LoanDate.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                            @if (loan.IsReturned)
                                            {
                                                <span> · Devolvido: @loan.ReturnDate!.Value.ToLocalTime().ToString("dd/MM/yy HH:mm")</span>
                                            }
                                        </MudText>
                                    </MudPaper>
                                }
                            }
                        </MudCardContent>
                    }
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private bool _loading = true;
    private List<GeneralItem> _items = [];
    private int _expandedHistoryId = -1;
    private Dictionary<int, List<GeneralItemLoan>> _historyCache = [];

    protected override async Task OnInitializedAsync() => await LoadItems();

    private async Task LoadItems()
    {
        _loading = true;
        _items = await ItemSvc.GetAllWithLoansAsync();
        _loading = false;
    }

    private async Task OpenLendDialog(GeneralItem item)
    {
        var parameters = new DialogParameters<LendItemDialog> { { x => x.ItemType, item } };
        var dialog = await DialogService.ShowAsync<LendItemDialog>($"Emprestar — {item.Name}", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadItems();
    }

    private async Task ReturnItem(GeneralItemLoan loan)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Devolver Artigo",
            $"Marcar o empréstimo do quarto {loan.RoomNumber} como devolvido?",
            yesText: "Sim, devolvido",
            cancelText: "Cancelar");

        if (confirmed == true)
        {
            await ItemSvc.ReturnItemAsync(loan.Id);
            await LoadItems();
            _historyCache.Remove(loan.GeneralItemId);
        }
    }

    private async Task ToggleHistory(int itemId)
    {
        if (_expandedHistoryId == itemId)
        {
            _expandedHistoryId = -1;
            return;
        }
        _expandedHistoryId = itemId;
        if (!_historyCache.ContainsKey(itemId))
            _historyCache[itemId] = await ItemSvc.GetHistoryAsync(itemId);
    }

    private async Task OpenAddDialog() => await OpenItemFormDialog(new GeneralItem());

    private async Task OpenEditDialog(GeneralItem item) =>
        await OpenItemFormDialog(new GeneralItem
        {
            Id = item.Id,
            Name = item.Name,
            TotalQuantity = item.TotalQuantity,
            Description = item.Description
        });

    private async Task OpenItemFormDialog(GeneralItem item)
    {
        var parameters = new DialogParameters<ItemTypeFormDialog> { { x => x.Item, item } };
        var dialog = await DialogService.ShowAsync<ItemTypeFormDialog>(
            item.Id == 0 ? "Adicionar Artigo" : "Editar Artigo", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadItems();
    }
}
