@page "/general-items"
@inject GeneralItemService ItemSvc
@inject ReservationService ReservaSvc
@inject ResidentService ResidentSvc
@inject SupabaseRealtimeService Realtime
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Artigos Gerais</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="OpenAddDialog">
        Adicionar Artigo
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">Nenhum artigo encontrado.</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="overflow-hidden">
        @for (int idx = 0; idx < _items.Count; idx++)
        {
            var item = _items[idx];
            var isLastItem = idx == _items.Count - 1;
            var activeLoans = item.Loans.Where(l => !l.IsReturned).OrderByDescending(l => l.LoanDate).ToList();

            <!-- ── Main item row ── -->
            <div class="d-flex align-center gap-3 px-4 py-3 flex-wrap"
                 style="border-bottom: 1px solid rgba(0,0,0,0.08);">

                <!-- Name + description -->
                <div style="flex:1; min-width:160px;">
                    <MudText Typo="Typo.body1" Style="font-weight:600;">@item.Name</MudText>
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                    }
                </div>

                <!-- Status chips -->
                <div class="d-flex gap-2 flex-wrap align-center">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(item.AvailableCount > 0 ? Color.Success : Color.Error)">
                        @item.AvailableCount disp.
                    </MudChip>
                    @if (item.ActiveLoansCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                            @item.ActiveLoansCount empr.
                        </MudChip>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        / @item.TotalQuantity
                    </MudText>
                </div>

                <!-- Action buttons -->
                <div class="d-flex gap-1 align-center">
                    <MudButton StartIcon="@Icons.Material.Filled.ArrowUpward"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(!item.HasAvailable)"
                               OnClick="@(() => OpenLendDialog(item))">
                        Emprestar
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.History"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="@(() => OpenHistoryDialog(item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenEditDialog(item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteItem(item))" />
                </div>
            </div>

            <!-- ── Active loan sub-rows ── -->
            @foreach (var loan in activeLoans)
            {
                <div class="d-flex align-center justify-space-between px-4 py-2"
                     style="background:rgba(0,0,0,0.025); border-bottom:1px solid rgba(0,0,0,0.06); padding-left:2rem !important;">
                    <div>
                        <MudText Typo="Typo.body2">
                            <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                     Size="Size.Small" Style="vertical-align:middle; opacity:0.4; margin-right:4px;" />
                            <b>@RoomDisplay(loan.RoomNumber)</b>
                            @if (loan.Quantity > 1)
                            {
                                <span style="color:var(--mud-palette-text-secondary)"> · @loan.Quantity unid.</span>
                            }
                            <span style="color:var(--mud-palette-text-secondary); font-size:0.78em; margin-left:8px;">
                                @loan.GivenBy · @loan.LoanDate.ToLocalTime().ToString("dd/MM HH:mm")
                            </span>
                        </MudText>
                        @if (!string.IsNullOrEmpty(loan.Notes))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="padding-left:24px;">
                                @loan.Notes
                            </MudText>
                        }
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="@(() => ReturnItem(loan))">
                        Devolver
                    </MudButton>
                </div>
            }

            <!-- Divider between items (but not after loan sub-rows, and not after last item) -->
            @if (!isLastItem && activeLoans.Count == 0)
            {
                <!-- border-bottom on main row already acts as divider -->
            }
        }
    </MudPaper>
}

@code {
    private bool _loading = true;
    private List<GeneralItem> _items = [];
    private Dictionary<string, Resident> _residentByRoom = [];

    protected override async Task OnInitializedAsync()
    {
        Realtime.TableChanged += OnTableChanged;
        await LoadItems();
    }

    private void OnTableChanged(string table)
    {
        if (table is "general_items" or "general_item_loans")
            InvokeAsync(LoadItems);
    }

    public void Dispose() => Realtime.TableChanged -= OnTableChanged;

    private async Task LoadItems()
    {
        _loading = true;
        var itemsTask     = ItemSvc.GetAllWithLoansAsync();
        var residentsTask = ResidentSvc.GetAllAsync();
        await Task.WhenAll(itemsTask, residentsTask);
        _items = itemsTask.Result;
        _residentByRoom = residentsTask.Result
            .Where(r => !string.IsNullOrEmpty(r.RoomNumber))
            .GroupBy(r => r.RoomNumber.ToUpper())
            .ToDictionary(g => g.Key, g => g.First());
        _loading = false;
    }

    private string RoomDisplay(string room) =>
        _residentByRoom.TryGetValue(room.ToUpper(), out var r)
            ? $"#{room} - {r.Name}"
            : $"#{room}";

    private async Task OpenLendDialog(GeneralItem item)
    {
        var linkedItem = item.LinkedItemId is not null
            ? _items.FirstOrDefault(x => x.Id == item.LinkedItemId)
            : null;
        var parameters = new DialogParameters<LendItemDialog>
        {
            { x => x.ItemType, item },
            { x => x.LinkedItem, linkedItem }
        };
        var dialog = await DialogService.ShowAsync<LendItemDialog>($"Emprestar — {item.Name}", parameters);
        if ((await dialog.Result) is { Canceled: false }) await LoadItems();
    }

    private async Task ReturnItem(GeneralItemLoan loan)
    {
        try
        {
            var linkedReservation = await ReservaSvc.GetActiveByLoanIdAsync(loan.Id);
            var message = linkedReservation is not null
                ? $"Devolver o cartão do {RoomDisplay(loan.RoomNumber)}? " +
                  $"A reserva associada ({SpaceLabel(linkedReservation.Space)} — {RoomDisplay(linkedReservation.RoomNumber)}) será automaticamente concluída."
                : $"Marcar o empréstimo do {RoomDisplay(loan.RoomNumber)} como devolvido?";

            var confirmed = await DialogService.ShowMessageBox(
                "Devolver Artigo", message, yesText: "Sim, devolvido", cancelText: "Cancelar");

            if (confirmed == true)
            {
                await ItemSvc.ReturnItemAsync(loan.Id);
                await LoadItems();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteItem(GeneralItem item)
    {
        var hasActive = item.Loans.Any(l => !l.IsReturned);
        var msg = hasActive
            ? $"Eliminar '{item.Name}'? Existem empréstimos activos que também serão eliminados."
            : $"Eliminar '{item.Name}' e todo o histórico associado?";

        var confirmed = await DialogService.ShowMessageBox(
            "Eliminar Artigo", msg, yesText: "Eliminar", cancelText: "Cancelar");

        if (confirmed == true)
        {
            await ItemSvc.DeleteItemAsync(item.Id);
            Snackbar.Add($"'{item.Name}' eliminado.", Severity.Success);
            await LoadItems();
        }
    }

    private async Task OpenHistoryDialog(GeneralItem item)
    {
        var parameters = new DialogParameters<ItemHistoryDialog> { { x => x.Item, item } };
        await DialogService.ShowAsync<ItemHistoryDialog>($"Histórico — {item.Name}", parameters);
    }

    private async Task OpenAddDialog() => await OpenItemFormDialog(new GeneralItem());

    private async Task OpenEditDialog(GeneralItem item) =>
        await OpenItemFormDialog(new GeneralItem
        {
            Id            = item.Id,
            Name          = item.Name,
            TotalQuantity = item.TotalQuantity,
            Description   = item.Description
        });

    private async Task OpenItemFormDialog(GeneralItem item)
    {
        var parameters = new DialogParameters<ItemTypeFormDialog> { { x => x.Item, item } };
        var dialog = await DialogService.ShowAsync<ItemTypeFormDialog>(
            string.IsNullOrEmpty(item.Id) ? "Adicionar Artigo" : "Editar Artigo", parameters);
        if ((await dialog.Result) is { Canceled: false }) await LoadItems();
    }

    private static string SpaceLabel(ReservationSpace space) =>
        space == ReservationSpace.Cozinha ? "Cozinha MasterChef" : "Cinema";
}
