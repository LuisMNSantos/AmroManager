@using AmroStockManager.Data.Models
@using AmroStockManager.Services
@inject AuditLogService AuditSvc

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Histórico de Operações</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                Não foi possível carregar o histórico. Certifica-te que a tabela
                <b>audit_logs</b> foi criada no Supabase.
                <MudText Typo="Typo.caption" Class="mt-1">@_error</MudText>
            </MudAlert>
        }
        else
        {
            <!-- Category filter chips -->
            <div class="d-flex gap-1 flex-wrap mb-3">
                <MudChip T="string" Size="Size.Small"
                         Color="@(_category is null ? Color.Primary : Color.Default)"
                         Variant="@(_category is null ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => _category = null)"
                         Style="cursor:pointer;">
                    Todos (@_logs.Count)
                </MudChip>
                @foreach (var cat in _catDefs)
                {
                    var c = cat;
                    var count = _logs.Count(l => GetCategory(l.Action) == c.Name);
                    if (count == 0) continue;
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_category == c.Name ? c.Color : Color.Default)"
                             Variant="@(_category == c.Name ? Variant.Filled : Variant.Outlined)"
                             Icon="@c.Icon"
                             OnClick="@(() => _category = c.Name)"
                             Style="cursor:pointer;">
                        @c.Name (@count)
                    </MudChip>
                }
            </div>

            <MudTextField @bind-Value="_search"
                          Placeholder="Pesquisar operação ou detalhes..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          FullWidth="true"
                          Class="mb-3" />

            @if (Filtered.Count == 0)
            {
                <MudText Color="Color.Secondary" Typo="Typo.body2">Sem registos.</MudText>
            }
            else
            {
                <MudTable Items="@Filtered" Dense="true" Hover="true" Elevation="0"
                          FixedHeader="true" Height="440px">
                    <HeaderContent>
                        <MudTh Style="width:108px">Data/Hora</MudTh>
                        <MudTh Style="width:110px">Categoria</MudTh>
                        <MudTh Style="width:190px">Operação</MudTh>
                        <MudTh>Detalhes</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Data/Hora">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @context.PerformedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Categoria">
                            @{
                                var cd = GetCategoryDef(context.Action);
                            }
                            <MudChip T="string" Size="Size.Small" Color="@cd.Color"
                                     Variant="Variant.Text"
                                     Style="height:20px; font-size:0.68rem; padding:0 6px;">
                                @cd.ShortName
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Operação">
                            <MudText Typo="Typo.body2"><b>@context.Action</b></MudText>
                        </MudTd>
                        <MudTd DataLabel="Detalhes">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @(context.Details ?? "—")
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    @Filtered.Count de @_logs.Count @(_logs.Count >= 2000 ? "entradas (limite 2000)" : "entradas")
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private bool    _loading  = true;
    private string? _error;
    private string  _search   = string.Empty;
    private string? _category;
    private List<AuditLog> _logs = [];

    private record CatDef(string Name, string ShortName, Color Color, string Icon);

    private static readonly CatDef[] _catDefs =
    [
        new("Residentes",     "Resid.",    Color.Primary,   Icons.Material.Filled.People),
        new("Encomendas",     "Encom.",    Color.Warning,   Icons.Material.Filled.Inventory2),
        new("Visitas",        "Visitas",   Color.Success,   Icons.Material.Filled.Groups),
        new("Reservas",       "Reservas",  Color.Info,      Icons.Material.Filled.EventNote),
        new("Artigos Gerais", "Artigos",   Color.Secondary, Icons.Material.Filled.Category),
        new("Reembolsos",     "Reemb.",    Color.Tertiary,  Icons.Material.Filled.Payments),
        new("Sistema",        "Sistema",   Color.Default,   Icons.Material.Filled.Settings),
    ];

    private static string GetCategory(string action) => action switch
    {
        var a when a.StartsWith("Encomenda") || a.StartsWith("Carta ") => "Encomendas",
        var a when a.StartsWith("Visita") || a.StartsWith("Checkout") || a.Contains("Excel Visitas") => "Visitas",
        var a when a.StartsWith("Reserva") => "Reservas",
        var a when a.StartsWith("Artigo") || a.StartsWith("BIS") => "Artigos Gerais",
        var a when a.StartsWith("Reembolso") => "Reembolsos",
        var a when a.StartsWith("Residente") || a.StartsWith("Lista")  ||
                  a.StartsWith("CSV")        || a.StartsWith("Registo") ||
                  a.StartsWith("Troca") => "Residentes",
        _ => "Sistema"
    };

    private CatDef GetCategoryDef(string action)
    {
        var name = GetCategory(action);
        return _catDefs.FirstOrDefault(c => c.Name == name) ?? _catDefs[^1];
    }

    private List<AuditLog> Filtered => _logs
        .Where(l => _category is null || GetCategory(l.Action) == _category)
        .Where(l => string.IsNullOrWhiteSpace(_search) ||
                    l.Action.Contains(_search,  StringComparison.OrdinalIgnoreCase) ||
                    (l.Details ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try   { _logs = await AuditSvc.GetAllAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
