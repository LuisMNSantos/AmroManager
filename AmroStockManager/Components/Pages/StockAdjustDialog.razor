@inject StockService StockSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Ajustar Stock — @VariantItem.Product?.Name @VariantItem.Size
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="MovementReason" @bind-Value="_reason" Label="Motivo" FullWidth="true">
                    <MudSelectItem Value="MovementReason.Sale">Venda / Saída</MudSelectItem>
                    <MudSelectItem Value="MovementReason.Restock">Reposição / Devolução</MudSelectItem>
                    <MudSelectItem Value="MovementReason.Adjustment">Ajuste Manual</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="int"
                                 @bind-Value="_amount"
                                 Label="Quantidade (negativo para reduzir)"
                                 FullWidth="true" />
            </MudItem>
            @if (_reason == MovementReason.Sale || _reason == MovementReason.Trade)
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="_roomNumber"
                                  Label="Número do Quarto"
                                  Required="true"
                                  RequiredError="Número do quarto obrigatório para uma venda"
                                  Immediate="true"
                                  FullWidth="true"
                                  Placeholder="ex: 405, 404A" />
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notas (opcional)" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Atual: <b>@VariantItem.Quantity</b> → Novo: <b>@Math.Max(0, VariantItem.Quantity + _amount)</b>
                </MudAlert>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply">Aplicar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public SizeVariant VariantItem { get; set; } = null!;
    [Parameter] public MovementReason DefaultReason { get; set; } = MovementReason.Sale;
    [Parameter] public int DefaultAmount { get; set; } = -1;

    private MovementReason _reason;
    private int _amount;
    private string? _roomNumber;
    private string? _notes;

    protected override void OnParametersSet()
    {
        _reason = DefaultReason;
        _amount = DefaultAmount;
    }

    private async Task Apply()
    {
        if (_amount == 0)
        {
            Snackbar.Add("A quantidade não pode ser zero.", Severity.Warning);
            return;
        }
        if ((_reason == MovementReason.Sale || _reason == MovementReason.Trade)
            && string.IsNullOrWhiteSpace(_roomNumber))
        {
            Snackbar.Add("Número do quarto obrigatório para uma venda.", Severity.Warning);
            return;
        }

        await StockSvc.AdjustStockAsync(VariantItem.Id, _amount, _reason, _notes, _roomNumber?.Trim());
        Snackbar.Add($"Stock atualizado para {VariantItem.Size}.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
