@inject ResidentService ResidentSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(_isNew ? "Novo Residente" : "Editar Residente")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_name"
                              Label="Nome completo"
                              FullWidth="true"
                              Required="true"
                              Immediate="true"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_room"
                              Label="Quarto"
                              Placeholder="ex: 101, 201A"
                              FullWidth="true"
                              Required="true"
                              Immediate="true"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_phone"
                              Label="Telemóvel (opcional)"
                              Placeholder="+351912345678"
                              FullWidth="true"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center">
                <MudCheckBox @bind-Value="_isCollaborator"
                             Label="Colaborador"
                             Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving" OnClick="Save">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Resident? Resident { get; set; }

    private string _name  = string.Empty;
    private string _room  = string.Empty;
    private string? _phone;
    private bool _isCollaborator;
    private bool _saving;

    private bool _isNew => Resident is null || string.IsNullOrEmpty(Resident.Id);

    protected override void OnInitialized()
    {
        if (Resident is not null)
        {
            _name           = Resident.Name;
            _room           = Resident.RoomNumber;
            _phone          = Resident.PhoneNumber;
            _isCollaborator = Resident.IsCollaborator;
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name)) { Snackbar.Add("Nome obrigatório.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_room)) { Snackbar.Add("Quarto obrigatório.", Severity.Warning); return; }

        _saving = true;
        try
        {
            await ResidentSvc.AddOrUpdateAsync(new Resident
            {
                Id              = Resident?.Id ?? string.Empty,
                Name            = _name,
                RoomNumber      = _room,
                PhoneNumber     = string.IsNullOrWhiteSpace(_phone) ? null : _phone,
                IsCollaborator  = _isCollaborator
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
            _saving = false;
        }
    }
}
