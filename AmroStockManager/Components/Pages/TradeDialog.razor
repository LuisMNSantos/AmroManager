@inject StockService StockSvc
@inject ResidentService ResidentSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Troca de Artigos</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            O artigo que sai abandona o stock (deve ter qtd. &gt; 0). O artigo que entra volta ao stock.
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-1">A Sair ↑</MudText>
                <MudSelect T="string" Value="_outProductId" ValueChanged="OnOutProductChanged"
                           Label="Produto" FullWidth="true">
                    @foreach (var p in AllProducts.Where(p => p.SizeVariants.Any(sv => sv.Quantity > 0)))
                    {
                        <MudSelectItem T="string" Value="@p.Id">@p.Name (@p.Type)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_outVariantId" Label="Tamanho" FullWidth="true" Class="mt-2">
                    @foreach (var sv in _outVariants)
                    {
                        <MudSelectItem T="string" Value="@sv.Id">@sv.Size — @sv.Quantity em stock</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="Color.Success" Class="mb-1">A Entrar ↓</MudText>
                <MudSelect T="string" Value="_inProductId" ValueChanged="OnInProductChanged"
                           Label="Produto" FullWidth="true">
                    @foreach (var p in AllProducts)
                    {
                        <MudSelectItem T="string" Value="@p.Id">@p.Name (@p.Type)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_inVariantId" Label="Tamanho" FullWidth="true" Class="mt-2">
                    @foreach (var sv in _inVariants)
                    {
                        <MudSelectItem T="string" Value="@sv.Id">@sv.Size (stock: @sv.Quantity)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudAutocomplete T="string"
                                 @bind-Value="_roomInput"
                                 Label="Número do Quarto"
                                 Required="true"
                                 RequiredError="Obrigatório"
                                 SearchFunc="SearchRooms"
                                 CoerceText="true"
                                 MinimumLength="1"
                                 Placeholder="ex: 405, 404A"
                                 FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_notes" Label="Notas (opcional)" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExecuteTrade">
            Confirmar Troca
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public List<Product> AllProducts { get; set; } = [];

    private string _outProductId = string.Empty;
    private string _outVariantId = string.Empty;
    private string _inProductId  = string.Empty;
    private string _inVariantId  = string.Empty;
    private string? _roomInput;
    private string? _notes;

    private List<SizeVariant> _outVariants = [];
    private List<SizeVariant> _inVariants = [];

    protected override void OnParametersSet()
    {
        var firstWithStock = AllProducts.FirstOrDefault(p => p.SizeVariants.Any(sv => sv.Quantity > 0));
        if (firstWithStock is not null)
        {
            _outProductId = firstWithStock.Id;
            _outVariants = firstWithStock.SizeVariants.Where(sv => sv.Quantity > 0).ToList();
            _outVariantId = _outVariants.FirstOrDefault()?.Id ?? string.Empty;
        }

        var firstIn = AllProducts.FirstOrDefault();
        if (firstIn is not null)
        {
            _inProductId = firstIn.Id;
            _inVariants = firstIn.SizeVariants.ToList();
            _inVariantId = _inVariants.FirstOrDefault()?.Id ?? string.Empty;
        }
    }

    private void OnOutProductChanged(string productId)
    {
        _outProductId = productId;
        _outVariants = AllProducts.FirstOrDefault(p => p.Id == productId)
                           ?.SizeVariants.Where(sv => sv.Quantity > 0).ToList() ?? [];
        _outVariantId = _outVariants.FirstOrDefault()?.Id ?? string.Empty;
    }

    private void OnInProductChanged(string productId)
    {
        _inProductId = productId;
        _inVariants = AllProducts.FirstOrDefault(p => p.Id == productId)
                          ?.SizeVariants.ToList() ?? [];
        _inVariantId = _inVariants.FirstOrDefault()?.Id ?? string.Empty;
    }

    private async Task ExecuteTrade()
    {
        if (string.IsNullOrWhiteSpace(_roomInput))
        {
            Snackbar.Add("Número do quarto obrigatório.", Severity.Warning);
            return;
        }
        if (string.IsNullOrEmpty(_outVariantId) || string.IsNullOrEmpty(_inVariantId))
        {
            Snackbar.Add("Selecione ambos os artigos.", Severity.Warning);
            return;
        }
        if (_outVariantId == _inVariantId)
        {
            Snackbar.Add("Os artigos de saída e entrada devem ser diferentes.", Severity.Warning);
            return;
        }

        var roomNumber = ResidentService.ParseRoomNumber(_roomInput);
        try
        {
            var ok = await StockSvc.TradeAsync(_outVariantId, _inVariantId, roomNumber, _notes);
            if (!ok)
            {
                Snackbar.Add("O artigo de saída está sem stock.", Severity.Error);
                return;
            }
            Snackbar.Add("Troca registada com sucesso.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

    private Task<IEnumerable<string>> SearchRooms(string value, CancellationToken ct) =>
        ResidentSvc.GetSuggestionsAsync(value);

    private void Cancel() => MudDialog.Cancel();
}
