@inject MaintenanceService MaintSvc
@inject BackupService BackupSvc
@inject SyncService SyncSvc
@inject ISnackbar Snackbar

<MudDialog Style="min-width:520px;">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CleaningServices" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Manutenção</MudText>
        </div>
    </TitleContent>
    <DialogContent>

        <!-- ── Sync section ── -->
        <MudPaper Outlined="true" Class="pa-3 mb-4">
            <div class="d-flex align-center gap-2 mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Sync" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">Sincronização entre Computadores</MudText>
                @if (!SyncSvc.IsConfigured)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Style="height:20px;">Não configurado</MudChip>
                }
            </div>
            <div class="d-flex align-center gap-3">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Última sincronização</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">
                        @(SyncSvc.LastSync is not null
                            ? SyncSvc.LastSync.Value.ToLocalTime().ToString("dd/MM/yy HH:mm")
                            : "—")
                    </MudText>
                </div>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sync"
                           Disabled="@(_syncing || !SyncSvc.IsConfigured)"
                           OnClick="DoSync">
                    @(_syncing ? "A sincronizar…" : "Sincronizar Agora")
                </MudButton>
            </div>
        </MudPaper>

        <!-- ── Backup section ── -->
        <MudPaper Outlined="true" Class="pa-3 mb-4">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@(BackupSvc.IsOneDrive ? Icons.Material.Filled.Cloud : Icons.Material.Filled.Storage)"
                         Color="@(BackupSvc.IsOneDrive ? Color.Primary : Color.Default)"
                         Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">Backup Automático</MudText>
                @if (BackupSvc.IsOneDrive)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Style="height:20px;">OneDrive</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Style="height:20px;">Local</MudChip>
                }
            </div>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2"
                     Style="word-break:break-all; font-size:0.72rem;">
                @BackupSvc.BackupFolder
            </MudText>

            <div class="d-flex align-center gap-4 flex-wrap">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Último backup</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">
                        @(_lastBackupTime is not null
                            ? _lastBackupTime.Value.ToString("dd/MM/yy HH:mm")
                            : "—")
                    </MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Cópias guardadas</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@_backupCount / 7</MudText>
                </div>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                               Size="Size.Small"
                               OnClick="OpenFolder" />
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Backup"
                           Disabled="_backing"
                           OnClick="DoManualBackup">
                    @(_backing ? "A fazer backup…" : "Fazer Backup")
                </MudButton>
            </div>
        </MudPaper>

        <!-- ── Cleanup section ── -->
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Elimina registos antigos (empréstimos devolvidos, reservas concluídas, movimentos de stock
            e encomendas/cartas entregues) para manter a base de dados leve.
        </MudText>

        <MudSelect T="int" Value="_months" Label="Eliminar registos mais antigos que"
                   FullWidth="true" Class="mb-4" ValueChanged="OnPeriodChanged">
            <MudSelectItem Value="1">1 mês</MudSelectItem>
            <MudSelectItem Value="3">3 meses</MudSelectItem>
            <MudSelectItem Value="6">6 meses</MudSelectItem>
            <MudSelectItem Value="12">1 ano</MudSelectItem>
        </MudSelect>

        @if (_loadingPreview)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else if (_preview is not null)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Registos que serão eliminados:</MudText>
                <div class="d-flex flex-column gap-1">
                    @foreach (var (label, count) in new (string, int)[] {
                        ("Empréstimos devolvidos",         _preview.ReturnedLoans),
                        ("Reservas concluídas/canceladas", _preview.OldReservations),
                        ("Movimentos de stock",            _preview.OldMovements),
                        ("Encomendas/Cartas entregues",    _preview.OldDeliveries)
                    })
                    {
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">@label</MudText>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(count > 0 ? Color.Warning : Color.Default)">
                                @count
                            </MudChip>
                        </div>
                    }
                </div>
                @if (Total == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-2">
                        Nenhum registo a eliminar para este período.
                    </MudText>
                }
            </MudPaper>
        }

        @if (_exportedPath is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                CSV exportado para:<br />
                <span style="font-size:0.78em; word-break:break-all;">@_exportedPath</span>
            </MudAlert>
        }

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Fechar</MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   Disabled="@(Total == 0 || _working)"
                   OnClick="ExportCsv">
            Exportar CSV
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   Disabled="@(Total == 0 || _working)"
                   OnClick="Cleanup">
            Limpar Histórico
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private int _months = 6;
    private bool _loadingPreview;
    private bool _working;
    private bool _backing;
    private bool _syncing;
    private CleanupPreview? _preview;
    private string? _exportedPath;
    private DateTime? _lastBackupTime;
    private int _backupCount;

    private int Total => _preview is null ? 0
        : _preview.ReturnedLoans + _preview.OldReservations + _preview.OldMovements + _preview.OldDeliveries;

    protected override async Task OnInitializedAsync()
    {
        RefreshBackupInfo();
        await LoadPreview();
    }

    private async Task DoSync()
    {
        _syncing = true;
        var (ok, msg) = await SyncSvc.SyncAsync();
        _syncing = false;
        Snackbar.Add(msg, ok ? Severity.Success : Severity.Error);
    }

    private void RefreshBackupInfo()
    {
        _lastBackupTime = BackupSvc.LastBackupTime;
        _backupCount    = BackupSvc.BackupCount;
    }

    private async Task DoManualBackup()
    {
        _backing = true;
        try
        {
            await BackupSvc.RunBackupAsync();
            RefreshBackupInfo();
            Snackbar.Add("Backup concluído com sucesso.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro no backup: {ex.Message}", Severity.Error);
        }
        _backing = false;
    }

    private void OpenFolder() => BackupSvc.OpenBackupFolder();

    private async Task OnPeriodChanged(int months)
    {
        _months = months;
        await LoadPreview();
    }

    private async Task LoadPreview()
    {
        _loadingPreview = true;
        _preview = await MaintSvc.GetPreviewAsync(_months);
        _loadingPreview = false;
    }

    private async Task ExportCsv()
    {
        _working = true;
        try
        {
            _exportedPath = await MaintSvc.ExportToCsvAsync(_months);
            Snackbar.Add("CSV exportado com sucesso.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao exportar: {ex.Message}", Severity.Error);
        }
        _working = false;
    }

    private async Task Cleanup()
    {
        _working = true;
        try
        {
            await MaintSvc.CleanupAsync(_months);
            Snackbar.Add($"{Total} registos eliminados. Base de dados compactada.", Severity.Success);
            await LoadPreview();
            _exportedPath = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao limpar: {ex.Message}", Severity.Error);
        }
        _working = false;
    }
}
