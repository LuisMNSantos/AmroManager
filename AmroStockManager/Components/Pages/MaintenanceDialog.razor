@inject MaintenanceService MaintSvc
@inject AuditLogService AuditSvc
@inject ISnackbar Snackbar

<MudDialog Style="min-width:520px;">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CleaningServices" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Manutenção</MudText>
        </div>
    </TitleContent>
    <DialogContent>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Elimina registos antigos (empréstimos devolvidos, reservas concluídas, movimentos de stock,
            encomendas/cartas entregues e visitas concluídas) para manter a base de dados leve.
        </MudText>

        <MudSelect T="int" Value="_months"
                   Label="@(_months == 0 ? "Eliminar registos" : "Eliminar registos mais antigos que")"
                   FullWidth="true" Class="mb-4" ValueChanged="OnPeriodChanged">
            <MudSelectItem Value="1">1 mês</MudSelectItem>
            <MudSelectItem Value="3">3 meses</MudSelectItem>
            <MudSelectItem Value="6">6 meses</MudSelectItem>
            <MudSelectItem Value="12">1 ano</MudSelectItem>
            <MudSelectItem Value="0">Tudo até hoje</MudSelectItem>
        </MudSelect>

        @if (_loadingPreview)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else if (_preview is not null)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Registos que serão eliminados:</MudText>
                <div class="d-flex flex-column">
                    @foreach (var row in _categoryRows)
                    {
                        <div class="d-flex align-center justify-space-between"
                             style="padding: 2px 0; @(row.Count == 0 ? "opacity:0.45;" : "")">
                            <MudCheckBox @bind-Value="row.Selected"
                                         Disabled="@(row.Count == 0)"
                                         Size="Size.Small"
                                         Dense="true"
                                         Label="@row.Label" />
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(row.Count > 0 ? Color.Warning : Color.Default)">
                                @row.Count
                            </MudChip>
                        </div>
                    }
                </div>
                @if (_preview.ReturnedLoans + _preview.OldReservations + _preview.OldMovements +
                     _preview.OldDeliveries + _preview.CompletedVisits == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-2">
                        Nenhum registo a eliminar para este período.
                    </MudText>
                }
            </MudPaper>
        }

        @if (_exportedPath is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                CSV exportado para:<br />
                <span style="font-size:0.78em; word-break:break-all;">@_exportedPath</span>
            </MudAlert>
        }

        <MudDivider Class="my-4" />

        <!-- GDPR / PII purge -->
        <div class="d-flex align-center gap-2 mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Warning" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">Eliminação permanente de dados pessoais (GDPR)</MudText>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Remove definitivamente da base de dados os registos de residentes que foram eliminados
            (soft-delete) @(_months == 0 ? "até hoje" : $"há mais de {_months} meses"). Esta operação é <b>irreversível</b> e
            elimina nome, quarto e telemóvel.
        </MudText>

        @if (_loadingPii)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mb-3" />
        }
        else
        {
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.body2">Residentes elegíveis para apagar:</MudText>
                <MudChip T="string" Size="Size.Small"
                         Color="@(_piiCount > 0 ? Color.Warning : Color.Default)">
                    @_piiCount
                </MudChip>
            </div>
        }

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Fechar</MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   Disabled="@(Total == 0 || _working)"
                   OnClick="ExportCsv">
            Exportar CSV
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   Disabled="@(Total == 0 || _working)"
                   OnClick="Cleanup">
            Limpar Histórico
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.DeleteForever"
                   Disabled="@(_piiCount == 0 || _working)"
                   OnClick="PurgePii">
            Apagar Dados Pessoais
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private class CategoryRow
    {
        public string Label    { get; init; } = string.Empty;
        public int    Count    { get; set; }
        public bool   Selected { get; set; }
    }

    private int _months = 6;
    private bool _loadingPreview;
    private bool _loadingPii;
    private bool _working;
    private CleanupPreview? _preview;
    private string? _exportedPath;
    private int _piiCount;

    private readonly CategoryRow[] _categoryRows =
    [
        new() { Label = "Empréstimos devolvidos"         },
        new() { Label = "Reservas concluídas/canceladas" },
        new() { Label = "Movimentos de stock"            },
        new() { Label = "Encomendas/Cartas entregues"    },
        new() { Label = "Visitas concluídas"             },
    ];

    private int Total => _categoryRows.Where(r => r.Selected).Sum(r => r.Count);

    private void SyncRows(CleanupPreview p)
    {
        _categoryRows[0].Count = p.ReturnedLoans;
        _categoryRows[1].Count = p.OldReservations;
        _categoryRows[2].Count = p.OldMovements;
        _categoryRows[3].Count = p.OldDeliveries;
        _categoryRows[4].Count = p.CompletedVisits;
        foreach (var r in _categoryRows) r.Selected = r.Count > 0;
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPreview(), LoadPiiPreview());
    }

    private async Task OnPeriodChanged(int months)
    {
        _months = months;
        await Task.WhenAll(LoadPreview(), LoadPiiPreview());
    }

    private async Task LoadPreview()
    {
        _loadingPreview = true;
        try
        {
            _preview = await MaintSvc.GetPreviewAsync(_months);
            if (_preview is not null) SyncRows(_preview);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar pré-visualização: {ex.Message}", Severity.Error);
        }
        finally { _loadingPreview = false; }
    }

    private async Task LoadPiiPreview()
    {
        _loadingPii = true;
        try
        {
            _piiCount = await MaintSvc.GetPiiPurgePreviewAsync(_months);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar dados PII: {ex.Message}", Severity.Error);
        }
        finally { _loadingPii = false; }
    }

    private async Task ExportCsv()
    {
        _working = true;
        try
        {
            _exportedPath = await MaintSvc.ExportToCsvAsync(_months);
            Snackbar.Add("CSV exportado com sucesso.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao exportar: {ex.Message}", Severity.Error);
        }
        _working = false;
    }

    private async Task Cleanup()
    {
        _working = true;
        try
        {
            var total = Total;
            var cats  = string.Join(", ", _categoryRows.Where(r => r.Selected).Select(r => r.Label));
            await MaintSvc.CleanupAsync(_months,
                loans:        _categoryRows[0].Selected,
                reservations: _categoryRows[1].Selected,
                movements:    _categoryRows[2].Selected,
                deliveries:   _categoryRows[3].Selected,
                visits:       _categoryRows[4].Selected);
            await LogAsync("Manutenção executada", $"{total} registos eliminados (>{_months} meses) · {cats}");
            Snackbar.Add($"{total} registos eliminados.", Severity.Success);
            await LoadPreview();
            _exportedPath = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao limpar: {ex.Message}", Severity.Error);
        }
        _working = false;
    }

    private async Task PurgePii()
    {
        _working = true;
        try
        {
            var count = _piiCount;
            await MaintSvc.PurgePiiAsync(_months);
            await LogAsync("PII eliminado", $"{count} residente(s) apagados permanentemente (>{_months} meses)");
            Snackbar.Add($"{count} residente(s) eliminados permanentemente.", Severity.Success);
            await LoadPiiPreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao Apagar: {ex.Message}", Severity.Error);
        }
        _working = false;
    }

    private async Task LogAsync(string action, string? details = null)
    {
        try { await AuditSvc.LogAsync(action, details); } catch { }
    }
}
